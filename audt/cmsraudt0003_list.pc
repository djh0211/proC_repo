#include <stdio.h>
#include <stdlib.h>
/*#include <macros.h>*/
#include <macro.h>

#include "xdsp_type.h"
#include "xdsp_util.h"
#include "xdsp_parser.h"
#include "xdsp_tcp.h"
#include "xdsp_api.h"
#include "xdsp_api_err.h"

#define ARRAY_SIZE 5000  /* 한 번에 업데이트할 건수 */


static      long        l_tot_cnt;
/*==========================================================================*/
/*함수 프로토타입 선언                     		                            */
/*==========================================================================*/
int  cmsraudt0001_list_SELECT ();
/*==========================================================================*/
/* 전역변수 선언( FML Buffer Pointer, HOST변수 )	                        */
/*==========================================================================*/
static		FILE		*out,*o_fp;
char	c_commands [124];

EXEC SQL BEGIN     DECLARE SECTION ;

/*
<LOGIC>
- 쿼리 결과를 혹은 바인딩에 활용되는 변수 선언은 무조건 varchar/int/double 혹은 이를 활용한 배열을 사용한다.
- 우선 이전에 사용하던 변수들을 하나도 안지우고 남겨두겠음. 후에 미사용되거나 변경되어야하는 애들은 사이즈와 이름을 변경한다.
- stmt/clause 등은 동적 쿼리를 위해 사용되어짐. 이는 너의 권유에 따라 varchar/char 등으로 너가 정해주면 됨.
</LOGIC>
*/
static      varchar     hv_stml_date      [9];  
static      varchar     hv_gubun		  [3];
static      varchar     hv_rgsdt		  [9];
static      varchar     hv_rowid	      [51]; /* ROWID			*/
static      varchar     hv_cstmr_dvscd	  [11]; /* 개인/법인구분			*/
static      varchar     hv_dbntr_ctgcd	  [11]; /* 채권종류					*/
static      varchar     hv_dbnno          [11]; /* 채권번호                 */
static      varchar     hv_sndng_dbnno    [11]; /* 수임안내문나간채권번호                 */
static      varchar     hv_cstmr_name     [41]; /* 성명						*/
static      varchar     hv_mbdb_name      [41]; /* 주채무자명	  			*/
static      varchar     hv_dbtr_rltname   [4]; /* 관계구분	  			*/
static      varchar     hv_first_acadt    [9];  /* 수임일자					*/
static      varchar     hv_sndng_date     [9];  /* 채권수임안내문발송일자	*/
static      varchar     hv_cnslt_date     [9];  /* 최초추심활동일자	        */
static      varchar     hv_stndy     	  [9];  /* 최초추심활동일자	        */
static      varchar     hv_cnslt_gubn     [21]; /* 최초추심활동방법	        */
static      varchar     hv_recv_emid      [8];  /* 담당자사번				*/
static      varchar     hv_recv_emid_name [21]; /* 담당자명					*/
static      varchar     hv_rgytr_rgino    [31]; /* 담당 협회등록번호(2012.05. kjy)	*/
static      varchar     hv_cstno          [11]; /* 고객번호-참고항목                 */
static      varchar     hv_fnsdt          [9];  /* 완결일자-참고항목                 */
static      varchar     hv_fnsh_dvscd     [3];  /* 완결구분-참고항목                 */
static      varchar		hv_ntytf_rsn_cntnt [51]; /*미발송사유-참고항목               */
static      varchar     hv_trscp_dvscd     [5];  /*위임사-참고항목                   */
static      varchar     hv_del_yn     	   [2];  /*보증인삭제여부-참고항목           */
static 		varchar		hv_cnslt_cntnt	  [401];

static      varchar     hv_trscp_dbnno     [41]; /* 위임사채권번호						*/
static 		varchar		hv_sgnas_code	   [21]; /* SKT 채권 종류 A3:특수 */
static      varchar     hv_old_dbnno       [11]; /* 채권번호                 */
static 		varchar		hv_old_sgnas_code  [21]; /* SKT 채권 종류 A3:특수 */
static      varchar     hv_old_first_acadt  [9]; /* 수임일자					*/

static      varchar     hv_dbnno_arr	    [100][11]; /* 채권번호 리스트				*/
static      varchar     hv_first_acadt_arr	[100][9]; /* 수임일자 리스트				*/


static		varchar		sql_stmt [60000];
static		varchar		sql_stmt2 [60000];

static		varchar		sql_stmt_skt1 [60000];
static		char		in_clause_skt1 [3000];



/* 일괄 UPDATE를 위한 배열 호스트 변수 선언 (넉넉하게 사이즈 할당) */
static		char 		arr_rowid          [ARRAY_SIZE][51];
static		char 		arr_sndng_date     [ARRAY_SIZE][10];
static		char 		arr_cnslt_date     [ARRAY_SIZE][10];
static		char 		arr_hv_stndy     [ARRAY_SIZE][10];
static		char 		arr_cnslt_gubn     [ARRAY_SIZE][25];
static		char 		arr_recv_emid_name [ARRAY_SIZE][25];
static		char 		arr_rgytr_rgino    [ARRAY_SIZE][35];
static		char 		arr_ntytf_rsn_cntnt[ARRAY_SIZE][55];
static		char 		arr_sndng_dbnno    [ARRAY_SIZE][15];
static 		char		arr_cnslt_cntnt	   [ARRAY_SIZE][405];





static 		int  		h_update_cnt;  /* 실제 업데이트될 건수를 담을 호스트 변수 */

/* Oracle User */
static varchar hv_userid    [20];
static varchar hv_passwd    [20];

EXEC SQL    END         DECLARE SECTION ;

/*
<LOGIC>
- 얘네는 쿼리가 아닌 일반 c로직을 위해서 사용되어짐. 바꿀 이유가 없음. 모든 코드 작성 후에 미사용되는애만 지우면 됨.
</LOGIC>
*/
int   i_sequ[40001],Main_rtn;
char  buf[21];
char  c_buffer[1001];
int   tot_scan,tot_fnsh,tot_zip_fail,tot_3,tot_0,tot_insert,rtn,ii,t_cust_cnt,
	  t_stml_cnt,jj,dm_cnt,hm_cnt, ps_cnt,hd_cnt, kk ;
int   i_ck_cnt=0;
int	  arr_idx = 0;

EXEC SQL    INCLUDE     sqlca.h ;

/*==========================================================================*/
/*          서비스 Main Process 함수                                        */
/*              1. 서비스명 기술                                            */
/*              2. Client로부터 전송된 데이타 수신                          */
/*              3. 입력 데이타 처리 함수(FML ==> Host)                      */
/*              4. 입력 테이타 체크 처리 함수                               */
/*              5. 데이타베이스 처리 및 출력 처리 함수                      */
/*==========================================================================*/
void main (int argc,char *argv[])
{

/*
<LOGIC>
- 프로그램 제어 코드로 여기를 바꿀 이유는 없음.
- 바꾼다면 커밋/롤백 제어 코드정도.
</LOGIC>
*/
    if (ora_init() ==  FAILURE) {
        printf("cmsraudt0003_list-CONNECT ERROR [%d][%s] \n", SQLCODE, SQLERRM );
        exit (-1) ;
    }

    if (argc == 3) {
        VCHINIT(hv_gubun);
        STR2VCH(hv_gubun,argv[1]);

		VCHINIT(hv_rgsdt);
        STR2VCH(hv_rgsdt,argv[2]);

        if (hv_gubun.len != 2) {
            printf("/*==================================================*/\n");
            printf("/*  Ex) cmsraudt0003_list 01 20260327               */\n");
            printf("/*==================================================*/\n");
            exit(-1);
        }
		if (hv_rgsdt.len != 8) {
            printf("/*==================================================*/\n");
            printf("/*  Ex) cmsraudt0003_list 01 20260327               */\n");
            printf("/*==================================================*/\n");
            exit(-1);
        }
        if ((strcmp(hv_gubun.arr , "01") != 0) &&
            (strcmp(hv_gubun.arr , "02") != 0) &&
            (strcmp(hv_gubun.arr , "03") != 0)) {
            printf("/*=========================================================*/\n");
            printf("/*  Ex) 인자값을 확인하세요                                */\n");
            printf("/*      [01:]      */\n");
            printf("/*=========================================================*/\n");
            exit(-1);
        }

    }
    else {
        printf("/*==================================================*/\n");
        printf("/*  Ex) cmsraudt0003_list 01                       */\n");
        printf("/*==================================================*/\n");
        exit(-1);
    }

	memset(c_commands , 0x00, sizeof(c_commands));
	strcat(c_commands, "audit/cmsraudt0003_list.log");

    if ((out = fopen(c_commands,"a")) == NULL) {
        printf("LOG FILE OPEN ERROR\n");
        exit(-1);
    }

	VCHINIT(hv_stml_date);
    EXEC SQL
        SELECT TO_CHAR(SYSDATE,'yyyymmdd')
        INTO   :hv_stml_date
        FROM   DUAL;


	CHRINIT(buf); common_gettime(buf,":");
	printf ("\n\n",hv_stml_date.arr,buf);
    fprintf (out,"\n\n",hv_stml_date.arr,buf);
    printf ("금감원 자료 추출 START : [%s][%s]\n",hv_stml_date.arr,buf);
    fprintf (out,"금감원 자료 추출 START : [%s][%s]\n",hv_stml_date.arr,buf);

	
    if (strcmp(hv_gubun.arr, "01") == 0) {

    	if (cmsraudt0003_list_SELECT () == FAILURE) {
			EXEC SQL ROLLBACK;
        	fclose(out);
        	exit (-1) ;
    	} 

	}

	CHRINIT(buf); common_gettime(buf,":");
    printf ("금감원 자료 추출 END : [%s][%s]\n",hv_stml_date.arr,buf);
    fprintf (out,"금감원 자료 추출 END : [%s][%s]\n",hv_stml_date.arr,buf);

	EXEC SQL COMMIT;



	fclose(out);
    exit (0);
}





/*==========================================================================*/
/* 함 수 명 : int cmsraudt0003_list_SELECT()        					*/
/* 파라메터 : 없음                                                          */
/* 설    명 : 
/* - 대상 채권x채무자 중 수임사실안내문 발송 혹은 동격의 sms발송일을 저장한다.  */
/* - 해당 채권x채무자에게 처음 이루어진 상담일과 해당 상담유형, 해당 상담내용, 입력자 등을 저장한다.  */
/* - 우선 skt 채권에 대해서만 코드를 작성하고 타 위임사로 확장한다.             */
/* 리 턴 값 : 성공시 SUCCESS(0), 실패시 FAILURE(-1)                         */
/*==========================================================================*/
int cmsraudt0003_list_SELECT ()
{

    /*
    <LOGIC>
    - 감사 대상 테이블에서 SKT 채권만 가져온다.
    - 그 중 A3 채권은 특수채권으로, 특수채권은 일반채권이 종결되면서 전환되는 경우가 있다.
    - 따라서 A3 채권의 경우 위임사채권번호로 msraccp17mt에서 A3가 아닌 일반채권 dbnno도 가져와야한다.
    </LOGIC>
    */


    /*
    <LOGIC>
    - 감사 대상 테이블에서 SKT 채권만 가져온다.
    </LOGIC>
    */
    EXEC SQL DECLARE CURS1_5000 CURSOR FOR
		SELECT
			/*+ FULL(A) */
			ROWID,

			CASE
				WHEN DBNTR_CTGCD = 'SKT' THEN (SELECT SGNAS_CODE FROM MSRCRDT01VT WHERE DBNNO = A.DBNNO)
				ELSE SUBSTR(TRSCP_DBNNO, 1, 1)
			END SGNAS_CODE, /* 채권종류코드 A3 등 */
			
			CSTMR_DVSCD,
			DBNTR_CTGCD,
			CSTNO,
			TRSCP_DVSCD,
			DBNNO,
			CSTMR_NAME,
			DBTNM,
			FNSDT,
			FIRST_ACADT,
			DBTR_RLTCD,
			DEL_YN,
			TRSCP_DBNNO
		FROM
			MSRAUDT01MT A
		WHERE
			FIRST_RGSDM >= TO_DATE(:hv_rgsdt, 'YYYYMMDD')
		AND FIRST_RGSDM <  TO_DATE(:hv_rgsdt, 'YYYYMMDD') + 1
		AND WORKDT IS NULL
		AND DBNTR_CTGCD IN ('SKT')
	;


    /*
    <LOGIC>
    - 커서 fetch. 한 행은 하나의 채권x채무자를 의미.
    - VCHINIT은 사용자정의함수로 varchar 변수를 재사용을 위해 초기화하는 함수임.
    - char를 쓰거나 배열변수를 쓰게될때, VCHINIT이 정상작동할지 정확히 모르면 정석으로 너가 작성해도됨.
    </LOGIC>
    */
    for (jj=0;;jj++) {
		VCHINIT(hv_rowid ); 	  /* ROWID		            */        
		VCHINIT(hv_cstmr_dvscd ); /* 개인/법인구분            */        
		VCHINIT(hv_dbntr_ctgcd ); /* 채권종류                 */
        VCHINIT(hv_dbnno  );      /* 채권번호                 */
        VCHINIT(hv_cstmr_name);   /* 채무자성명               */
		VCHINIT(hv_mbdb_name);    /* 주채무자성명               */		
		VCHINIT(hv_first_acadt);  /* 수임일자                 */
		VCHINIT(hv_dbtr_rltname);  /* 관계구분                 */
        VCHINIT(hv_cstno);        /* 고객번호-참고항목        */
		VCHINIT(hv_trscp_dvscd);  /*위임사-참고항목           */ 
        VCHINIT(hv_fnsdt);        /* 완결일자-참고항목        */
		VCHINIT(hv_del_yn);       /* 보증인삭제여부-참고항목        */
		
        VCHINIT(hv_sndng_date);  /* 채권수임안내문발송일자   */
        VCHINIT(hv_cnslt_date);  /* 최초추심활동일자         */
        VCHINIT(hv_cnslt_gubn); /* 최초추심활동방법         */        
        VCHINIT(hv_recv_emid_name);/* 담당자명                 */
        VCHINIT(hv_rgytr_rgino); /* 담당 협회등록번호  */
        VCHINIT(hv_ntytf_rsn_cntnt); /*미발송사유-참고항목               */
		VCHINIT(hv_trscp_dbnno); /* 위임사채권번호               */
		VCHINIT(hv_sgnas_code); /* SKT 채권종류               */
		

		EXEC SQL FETCH CURS1_5000 INTO
			:hv_rowid,
			:hv_sgnas_code,
			:hv_cstmr_dvscd,	:hv_dbntr_ctgcd,	:hv_cstno,  	:hv_trscp_dvscd,
			:hv_dbnno, 			:hv_cstmr_name,		:hv_mbdb_name,	:hv_fnsdt,
			:hv_first_acadt,	:hv_dbtr_rltname,	:hv_del_yn,		:hv_trscp_dbnno;

        /*
        <LOGIC>
        - 이 또한 사용자정의값으로, SQLCODE와 SQLERRM으로 결과코드를 조작함.
        </LOGIC>
        */
		if (SQLCODE == SQL_NO_DATA)
			break;
        else if (SQLCODE != SQL_OK) {
			printf ("cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			fprintf(out,"cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			EXEC SQL CLOSE CURS1_5000;
			return FAILURE;
        }

		l_tot_cnt++;

		if (l_tot_cnt % 100 == 0) {
			CHRINIT(buf); common_gettime(buf,":");
			printf ("cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
			fprintf (out,"cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
		}


        /*
        <LOGIC>
        1. SKT
            if(SGNAS_CODE = A3)
            - where cstno = :hv_cstno and dbnno in (전환 전 채권들 + 현재 채권) from msrcspr01mt에서 첫 상담일자(cnslt_date)를 select
                - 조회성공시. 최초 상담이력의 dbnno, first_acadt(수임일자), cnslt_date, 상담유형, 입력자 정보등을 추가로 받아야함.(이는 여러 테이블에 나눠있음)
                - no data. 상담 없음.
            - from msrursn01mt where cstno = :hv_cstno and dbnno in (전환 전 채권들 + 현재 채권) and post_sndng_date is not null 로 수임일자 min(발송일) get
            else()
            - 현재 채권번호로 첫 상담일자 select
            - 현재 채권번호로 수임일자 select
        2. ELSE
            - TODO
        </LOGIC>
        */

        /*
        <LOGIC>
        - 작성하다가 말았는데 결국 내가 고민한 포인트는 아래와 같다.
            - 전환 전 채권정보를 일단 가져오고 나서 각 테이블에서 상담이력과 발송정보를 가져오느냐?(그러면 검색할때마다 dbnno 리스트 동적쿼리혹은커서 혹은 for 제어로 다수의 쿼리)
            - 아니면 매 쿼리마다 전환 전 채권정보를 서브쿼리안에 둘까.(복잡성 + pro*c 11버전으로 스칼라 서브쿼리 내 집계함수 불가 => 동적쿼리혹은커서 사용)
        - 우선 쿼리들을 참고해서 뭐가 좋을지 너가 짜봐. 계속적으로 내가 피드백과 정확한 쿼리는 수정해줄게.
        </LOGIC>
        */
        VCHINIT(hv_old_dbnno);
		VCHINIT(hv_old_first_acadt);
		if (strcmp(hv_dbntr_ctgcd.arr, "SKT") == 0) {

			if (strcmp(hv_sgnas_code.arr, "A3") == 0) {
				/* 특수채권 */
				EXEC SQL OPEN CURS_SKT_A3_1;
				if (SQLCODE != SQL_OK)  {
					fprintf(o_fp,"CURS_SKT_A3_1 발췌중 ERR발생(OPEN) [%d][%s] \n", SQLCODE, SQLERRM );
					printf("CURS_SKT_A3_1 발췌중 ERR발생(OPEN) [%d][%s] \n", SQLCODE, SQLERRM );
					EXEC SQL CLOSE CURS_SKT_A3_1;
					EXEC SQL ROLLBACK;
					return FAILURE;
				}

				memset(hv_dbnno_arr, 0x00, sizeof(hv_dbnno_arr));
				memset(hv_first_acadt_arr, 0x00, sizeof(hv_first_acadt_arr));
				for (ii = 0 ;; ii++ ) {
					memset(&hv_old_dbnno, 0x00, sizeof(hv_old_dbnno));
					memset(&hv_old_first_acadt, 0x00, sizeof(hv_old_first_acadt));
					
					/*
                    <LOGIC>
                    - 전환 전 채권 가져오기
                    - A3 제외는 현재 채권을 제외하기 위함임.
                    </LOGIC>
                    */
                    EXEC SQL DECLARE CURS_SKT_A3_1 CURSOR FOR
                        SELECT
                            DBNNO,
                            FIRST_ACADT
                        FROM
                            MSRACCP01MT A
                        WHERE
                            A.DATA_STTCD = '1'
                        AND A.CMISS_DVSCD != 'A3'
                        AND A.SRVC_MNGNO = :hv_trscp_dbnno
                    ;

                    /*
                    <LOGIC>
                    - 전환 전 채권들로만 최초상담일 찾기(짤 로직방향에 따라 현재 채권까지 포함해도 됨)
                    - 제외조건은 추심활동으로 안보는 것들임
                    - 저 stmt는 전환 전 채권들 in 절에 쓰게 만들어보려던것. 저렇게 안해도 됨.
                    </LOGIC>
                    */
                    if (ii != 0) {
                        /* 하나라도 조회되었으면 */
                        int k = 0;
                        int offset = 0;

                        /* 1. IN 절 문자열 생성 ('값1', '값2', ...) */
                        memset(in_clause_skt1, 0x00, sizeof(in_clause_skt1));
                        for (k = 0; k < ii; k++) {
                            /* 각 원소 끝에 널 문자 처리 (안전장치) */
                            hv_dbnno_arr[k].arr[hv_dbnno_arr[k].len] = '\0';
                            
                            if (k == 0) {
                                offset += sprintf(in_clause_skt1 + offset, "'%s'", hv_dbnno_arr[k].arr);
                            } else {
                                offset += sprintf(in_clause_skt1 + offset, ",'%s'", hv_dbnno_arr[k].arr);
                            }
                        }

                        /* 2. 전체 동적 SQL 조립 */
                        memset(&SKT_A3_2_STMT, 0x00, sizeof(SKT_A3_2_STMT));
                        SKT_A3_2_STMT.len = sprintf((char *)SKT_A3_2_STMT.arr,
                            "SELECT COUNT(*), MIN(CNSLT_DATE) \n"
                            "FROM MSRCSPR01MT A \n"
                            "WHERE TRSCP_DVSCD = :v1 \n"
                            "  AND NVL(GRNTR_CSTNO, CSTNO) = :v2 \n"
                            "  AND A.DBNNO IN (%s) \n" /* ★ 조립한 IN 절 삽입 */
                            "  AND A.DATA_STTCD = '1' \n"
                            "  AND A.AZTN_DVSCD IN ('B3','B4','B1','C1','C2','C3','B5') \n"
                            "  AND NOT ( \n"
                            "      A.AZTN_DVSCD IN ('B4', 'B3') \n"
                            "      AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR \n"
                            "          (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR \n"
                            "          (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01')) \n"
                            "      AND A.PRMAM = 0) \n"
                            "  AND RTRN_CODE IS NULL \n"
                            "  AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%%') ", /* ★ %를 %%로 작성 */
                            in_clause_skt1
                        );

                        EXEC SQL PREPARE min_date_stmt FROM :SKT_A3_2_STMT;
                        EXEC SQL DECLARE cur_min_date CURSOR FOR min_date_stmt;
                        
                    }
                }

			
				/*
                    <LOGIC>
                    - 상담내역 하나라도 잡히면.
                    - 유형, 입력자, 상담내용, 입력자의 자격번호 등을 가져온다.
                    - c 문법 틀렸으니까 그냥 쿼리만 참고하길.
                    </LOGIC>
                */
				if (i_ck_cnt > 0) {

					/*===============================================================*/
					/* 3.추심활동내역-방법 	    				           			 */
					/*===============================================================*/
					VCHINIT(hv_cnslt_gubn); /* 최초추심활동방법         */
					VCHINIT(hv_recv_emid);  /* 담당자                 */
					VCHINIT(hv_cnslt_cntnt);  /* 담당자                 */

					VCHINIT(sql_stmt);
                    sprintf((char *)sql_stmt.arr,
                        "SELECT "
                        "    CASE "
                        "        WHEN AZTN_DVSCD IN ('B3','B4') THEN 'DM' "
                        "        WHEN AZTN_DVSCD IN ('B1','C1','C2','C3') THEN '전화' "
                        "        WHEN AZTN_DVSCD IN ('B5') THEN 'SMS' "
                        "        ELSE '기타' "
                        "    END CNSLT_GUBN, "
                        "    PRINC_EMINO, "
                        "    NVL(SUBSTR(CNSLT_CNTNT, 1, 400), ' ') " /* ORA-01405 방지용 NVL */
                        "FROM "
                        "    ( "
                        "    SELECT "
                        "        AZTN_DVSCD, "
                        "        PRINC_EMINO, "
                        "        CNSLT_CNTNT, "
                        "        ROW_NUMBER() OVER(ORDER BY FIRST_RGSDM) RN "
                        "    FROM     "
                        "        MSRCSPR01MT A "
                        "    WHERE    "
                        "        TRSCP_DVSCD = :v1 " /* 바인드 변수 처리 */
                        "    AND NVL(GRNTR_CSTNO, CSTNO) = :v2 "
                        "    AND A.CNSLT_DATE >= :v3 "
                        "    AND A.DBNNO = :v4 "
                        "    AND A.DATA_STTCD = '1' "
                        "    AND A.AZTN_DVSCD IN ('B3', 'B4', 'B1', 'C1', 'C2', 'C3', 'B5') "
                        "    AND NOT (  "
                        "            A.AZTN_DVSCD IN ('B4', 'B3') "
                        "        AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR "
                        "            (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR "
                        "            (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01')) "
                        "        AND A.PRMAM = 0) "
                        "    AND RTRN_CODE IS NULL "
                        "    AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%%') " /* C언어 포맷팅 이스케이프 */
                        "    ) A "
                        "WHERE "
                        "    RN = 1 "
                    );
					
					/*===============================================================*/
					/* 4.최초추심활동시작 당시 추심담당자		           			 */
					/*===============================================================*/
					VCHINIT(hv_recv_emid_name);/* 담당자명                 */
					EXEC SQL
					SELECT EMPLY_KRNNM 
					INTO   :hv_recv_emid_name
					FROM MHREMPL01MT
					WHERE EMINO = :hv_recv_emid;

					/*===============================================================*/
					/* 5.신용정보협회 등록번호            		           			 */
					/*===============================================================*/
					VCHINIT(hv_rgytr_rgino); /* 담당 협회등록번호  */

					EXEC SQL
					SELECT TRIM(SUBSTR(RGYTR_RGINO,1,12))
					INTO  :hv_rgytr_rgino
					FROM MHREMPL09MT
					WHERE EMINO = :hv_recv_emid;
						
				}


                /*===============================================================*/
                /* 6.미발송사유													 */
                /*===============================================================*/
                VCHINIT(hv_ntytf_rsn_cntnt); /*미발송사유-참고항목               */     
                
                if (strcmp(hv_sndng_date.arr,"") == 0) {
                    EXEC SQL			
                    SELECT	replace(replace(CNSLT_CNTNT,CHR(10),''),chr(13),'')
                    INTO	:hv_ntytf_rsn_cntnt
                    FROM
                    (
                        SELECT CNSLT_CNTNT
                        FROM MSRCSPR01MT
                        WHERE CSTNO = :hv_cstno
                        AND TRSCP_DVSCD = :hv_trscp_dvscd
                        AND CNSLT_DATE >= :hv_first_acadt
                        AND AZTN_DVSCD = 'B9'
                        AND DATA_STTCD = '1'
                        UNION ALL
                        SELECT CNSLT_CNTNT
                        FROM MSRCSPR01MT
                        WHERE GRNTR_CSTNO = :hv_cstno
                        AND TRSCP_DVSCD = :hv_trscp_dvscd
                        AND CNSLT_DATE >= :hv_first_acadt
                        AND AZTN_DVSCD = 'B9'
                        AND DATA_STTCD = '1')
                    WHERE	ROWNUM = 1;	
                }
                

                /*
                    <LOGIC>
                    - 벌크 업데이트하려고 이렇게 만들었었음.
                    - 참고만
                    </LOGIC>
                *
                /*===============================================================*/
                /* 7.테이블에 작성												 */
                /*===============================================================*/
                memset(arr_rowid[arr_idx], 0x00, 51);
                strncpy(arr_rowid[arr_idx], (char *)hv_rowid.arr, hv_rowid.len);
                
                memset(arr_sndng_date[arr_idx], 0x00, 10);
                strncpy(arr_sndng_date[arr_idx], (char *)hv_sndng_date.arr, hv_sndng_date.len);
                
                memset(arr_cnslt_date[arr_idx], 0x00, 10);
                strncpy(arr_cnslt_date[arr_idx], (char *)hv_cnslt_date.arr, hv_cnslt_date.len);
                
                memset(arr_hv_stndy[arr_idx], 0x00, 10);
                strncpy(arr_hv_stndy[arr_idx], (char *)hv_stndy.arr, hv_stndy.len);

                memset(arr_cnslt_gubn[arr_idx], 0x00, 25);
                strncpy(arr_cnslt_gubn[arr_idx], (char *)hv_cnslt_gubn.arr, hv_cnslt_gubn.len);
                
                memset(arr_recv_emid_name[arr_idx], 0x00, 25);
                strncpy(arr_recv_emid_name[arr_idx], (char *)hv_recv_emid_name.arr, hv_recv_emid_name.len);
                
                memset(arr_rgytr_rgino[arr_idx], 0x00, 35);
                strncpy(arr_rgytr_rgino[arr_idx], (char *)hv_rgytr_rgino.arr, hv_rgytr_rgino.len);
                
                memset(arr_ntytf_rsn_cntnt[arr_idx], 0x00, 55);
                strncpy(arr_ntytf_rsn_cntnt[arr_idx], (char *)hv_ntytf_rsn_cntnt.arr, hv_ntytf_rsn_cntnt.len);

                memset(arr_sndng_dbnno[arr_idx], 0x00, 15);
                strncpy(arr_sndng_dbnno[arr_idx], (char *)hv_sndng_dbnno.arr, hv_sndng_dbnno.len);

                
                memset(arr_cnslt_cntnt[arr_idx], 0x00, 405);
                strncpy(arr_cnslt_cntnt[arr_idx], (char *)hv_cnslt_cntnt.arr, hv_cnslt_cntnt.len);

			}

            arr_idx++;

            if (arr_idx == ARRAY_SIZE) {
                h_update_cnt = arr_idx;

                /* FOR 구문을 사용하여 5000건을 단 1번의 쿼리로 UPDATE */
                EXEC SQL FOR :h_update_cnt
                    UPDATE MSRAUDT01MT
                    SET WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
                        --STNDY = :arr_hv_stndy,
                        --SNDNG_DATE = :arr_sndng_date,
                        CNSLT_DATE = :arr_cnslt_date,
                        CNSLT_GUBN = :arr_cnslt_gubn,
                        RECV_EMID_NAME = :arr_recv_emid_name,
                        RGYTR_RGINO = :arr_rgytr_rgino,
                        CNSLT_CNTNT = :arr_cnslt_cntnt
                        --NTYTF_RSN_CNTNT = :arr_ntytf_rsn_cntnt,
                        --SNDNG_DBNNO = :arr_sndng_dbnno
                    WHERE ROWID = :arr_rowid;

                if (SQLCODE != SQL_OK) {
                    printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
                    fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
                    EXEC SQL CLOSE CURS1_5000;
                    return FAILURE;
                }

                /* 언두(Undo) 스페이스 확보를 위해 5000건마다 커밋 (선택) */
                /* EXEC SQL COMMIT; */

                arr_idx = 0; /* 업데이트 완료 후 인덱스 초기화 */
            }

		}


        /* 남은 자투리 데이터가 있다면 마지막 일괄 UPDATE 수행 */
        if (arr_idx > 0) {
            h_update_cnt = arr_idx;

            EXEC SQL FOR :h_update_cnt
                UPDATE MSRAUDT01MT
                SET WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
                    --STNDY = :arr_hv_stndy,
                    --SNDNG_DATE = :arr_sndng_date,
                    CNSLT_DATE = :arr_cnslt_date,
                    CNSLT_GUBN = :arr_cnslt_gubn,
                    RECV_EMID_NAME = :arr_recv_emid_name,
                    RGYTR_RGINO = :arr_rgytr_rgino,
                    CNSLT_CNTNT = :arr_cnslt_cntnt
                    --NTYTF_RSN_CNTNT = :arr_ntytf_rsn_cntnt,
                    --SNDNG_DBNNO = :arr_sndng_dbnno
                WHERE ROWID = :arr_rowid;

            if (SQLCODE != SQL_OK) {
                printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
                fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
                EXEC SQL CLOSE CURS1_5000;
                return FAILURE;
            }
            
            /*EXEC SQL COMMIT;*/
        }

        EXEC SQL CLOSE CURS1_5000;
        return SUCCESS;



    }


}


/*==========================================================================*/
/*                              END OF SOURCE                               */
/*==========================================================================*/
