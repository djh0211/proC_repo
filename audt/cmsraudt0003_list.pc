#include <stdio.h>
#include <stdlib.h>
/*#include <macros.h>*/
#include <macro.h>

#include "xdsp_type.h"
#include "xdsp_util.h"
#include "xdsp_parser.h"
#include "xdsp_tcp.h"
#include "xdsp_api.h"
#include "xdsp_api_err.h"

#define ARRAY_SIZE 5000  /* 한 번에 업데이트할 건수 */


static      long        l_tot_cnt;
/*==========================================================================*/
/*함수 프로토타입 선언                     		                            */
/*==========================================================================*/
int  cmsraudt0003_list_SELECT ();
/*==========================================================================*/
/* 전역변수 선언( FML Buffer Pointer, HOST변수 )	                        */
/*==========================================================================*/
static		FILE		*out,*o_fp;
char	c_commands [124];

EXEC SQL BEGIN     DECLARE SECTION ;

static      varchar     hv_stml_date      [9];
static      varchar     hv_gubun		  [3];
static      varchar     hv_rgsdt		  [9];
static      varchar     hv_rowid	      [51];
/* ROWID			*/
static      varchar     hv_cstmr_dvscd	  [11];
/* 개인/법인구분			*/
static      varchar     hv_dbntr_ctgcd	  [11];
/* 채권종류					*/
static      varchar     hv_dbnno          [11];
/* 채권번호                 */
static      varchar     hv_sndng_dbnno    [11];
/* 수임안내문나간채권번호                 */
static      varchar     hv_cstmr_name     [41];
/* 성명						*/
static      varchar     hv_mbdb_name      [41];
/* 주채무자명	  			*/
static      varchar     hv_dbtr_rltname   [4];
/* 관계구분	  			*/
static      varchar     hv_first_acadt    [9];
/* 수임일자					*/
static      varchar     hv_sndng_date     [9];
/* 채권수임안내문발송일자	*/
static      varchar     hv_cnslt_date     [9];
/* 최초추심활동일자	        */
static      varchar     hv_stndy     	  [9];
/* 최초추심활동일자	        */
static      varchar     hv_cnslt_gubn     [21];
/* 최초추심활동방법	        */
static      varchar     hv_recv_emid      [8];
/* 담당자사번				*/
static      varchar     hv_recv_emid_name [21];
/* 담당자명					*/
static      varchar     hv_rgytr_rgino    [31];
/* 담당 협회등록번호(2012.05. kjy)	*/
static      varchar     hv_cstno          [11];
/* 고객번호-참고항목                 */
static      varchar     hv_fnsdt          [9];
/* 완결일자-참고항목                 */
static      varchar     hv_fnsh_dvscd     [3];
/* 완결구분-참고항목                 */
static      varchar		hv_ntytf_rsn_cntnt [51];
/*미발송사유-참고항목               */
static      varchar     hv_trscp_dvscd     [5];
/*위임사-참고항목                   */
static      varchar     hv_del_yn     	   [2];
/*보증인삭제여부-참고항목           */
static 		varchar		hv_cnslt_cntnt	  [401];
static      varchar     hv_trscp_dbnno     [41];
/* 위임사채권번호						*/
static 		varchar		hv_sgnas_code	   [21]; /* SKT 채권 종류 A3:특수 */
static      varchar     hv_old_dbnno       [11];
/* 채권번호                 */
static 		varchar		hv_old_sgnas_code  [21];
/* SKT 채권 종류 A3:특수 */
static      varchar     hv_old_first_acadt  [9];
/* 수임일자					*/

static      varchar     hv_dbnno_arr	    [100][11];
/* 채권번호 리스트				*/
static      varchar     hv_first_acadt_arr	[100][9];
/* 수임일자 리스트				*/

/* 동적 쿼리용 변수 */
static		varchar		sql_stmt [60000];
static		varchar		sql_stmt2 [60000];
static		varchar		sql_stmt_skt1 [60000];
static		char		in_clause_skt1 [3000];

/* 일괄 UPDATE를 위한 배열 호스트 변수 선언 (넉넉하게 사이즈 할당) */
static		char 		arr_rowid          [ARRAY_SIZE][51];
static		char 		arr_sndng_date     [ARRAY_SIZE][10];
static		char 		arr_cnslt_date     [ARRAY_SIZE][10];
static		char 		arr_hv_stndy     [ARRAY_SIZE][10];
static		char 		arr_cnslt_gubn     [ARRAY_SIZE][25];
static		char 		arr_recv_emid_name [ARRAY_SIZE][25];
static		char 		arr_rgytr_rgino    [ARRAY_SIZE][35];
static		char 		arr_ntytf_rsn_cntnt[ARRAY_SIZE][55];
static		char 		arr_sndng_dbnno    [ARRAY_SIZE][15];
static 		char		arr_cnslt_cntnt	   [ARRAY_SIZE][405];

/* 추가된 업데이트 칼럼용 배열 호스트 변수 */
static 		char		arr_sgnas_code	   [ARRAY_SIZE][25];
static 		char		arr_old_dbnno      [ARRAY_SIZE][15];
static 		char		arr_old_first_acadt[ARRAY_SIZE][10];

static 		int  		h_update_cnt;  /* 실제 업데이트될 건수를 담을 호스트 변수 */

/* Oracle User */
static varchar hv_userid    [20];
static varchar hv_passwd    [20];

EXEC SQL    END         DECLARE SECTION ;

int   i_sequ[40001],Main_rtn;
char  buf[21];
char  c_buffer[1001];
int   tot_scan,tot_fnsh,tot_zip_fail,tot_3,tot_0,tot_insert,rtn,ii,t_cust_cnt,
	  t_stml_cnt,jj,dm_cnt,hm_cnt, ps_cnt,hd_cnt, kk ;
int   i_ck_cnt=0;
int	  arr_idx = 0;

EXEC SQL    INCLUDE     sqlca.h ;

/*==========================================================================*/
/* 서비스 Main Process 함수                                        */
/*==========================================================================*/
void main (int argc,char *argv[])
{
    if (ora_init() ==  FAILURE) {
        printf("cmsraudt0003_list-CONNECT ERROR [%d][%s] \n", SQLCODE, SQLERRM );
        exit (-1) ;
    }

    if (argc == 3) {
        VCHINIT(hv_gubun);
        STR2VCH(hv_gubun,argv[1]);

		VCHINIT(hv_rgsdt);
        STR2VCH(hv_rgsdt,argv[2]);

        if (hv_gubun.len != 2) {
            printf("/*==================================================*/\n");
            printf("/* Ex) cmsraudt0003_list 01 20260327               */\n");
            printf("/*==================================================*/\n");
            exit(-1);
        }
		if (hv_rgsdt.len != 8) {
            printf("/*==================================================*/\n");
            printf("/* Ex) cmsraudt0003_list 01 20260327               */\n");
            printf("/*==================================================*/\n");
            exit(-1);
        }
        if ((strcmp(hv_gubun.arr , "01") != 0) &&
            (strcmp(hv_gubun.arr , "02") != 0) &&
            (strcmp(hv_gubun.arr , "03") != 0)) {
            printf("/*=========================================================*/\n");
            printf("/* Ex) 인자값을 확인하세요                                */\n");
            printf("/* [01:]      */\n");
            printf("/*=========================================================*/\n");
            exit(-1);
        }

    }
    else {
        printf("/*==================================================*/\n");
        printf("/* Ex) cmsraudt0003_list 01                       */\n");
        printf("/*==================================================*/\n");
        exit(-1);
    }

	memset(c_commands , 0x00, sizeof(c_commands));
	strcat(c_commands, "audit/cmsraudt0003_list.log");

    if ((out = fopen(c_commands,"a")) == NULL) {
        printf("LOG FILE OPEN ERROR\n");
        exit(-1);
    }

	VCHINIT(hv_stml_date);
    EXEC SQL
        SELECT TO_CHAR(SYSDATE,'yyyymmdd')
        INTO   :hv_stml_date
        FROM   DUAL;
        
    CHRINIT(buf); common_gettime(buf,":");
	printf ("\n\n",hv_stml_date.arr,buf);
    fprintf (out,"\n\n",hv_stml_date.arr,buf);
    printf ("금감원 자료 추출 START : [%s][%s]\n",hv_stml_date.arr,buf);
    fprintf (out,"금감원 자료 추출 START : [%s][%s]\n",hv_stml_date.arr,buf);
    
    if (strcmp(hv_gubun.arr, "01") == 0) {
    	if (cmsraudt0003_list_SELECT () == FAILURE) {
			EXEC SQL ROLLBACK;
        	fclose(out);
            exit (-1) ;
    	} 
	}

	CHRINIT(buf); common_gettime(buf,":");
    printf ("금감원 자료 추출 END : [%s][%s]\n",hv_stml_date.arr,buf);
    fprintf (out,"금감원 자료 추출 END : [%s][%s]\n",hv_stml_date.arr,buf);
    
    EXEC SQL COMMIT;

	fclose(out);
    exit (0);
}


/*==========================================================================*/
/* 함 수 명 : int cmsraudt0003_list_SELECT()        					*/
/*==========================================================================*/
int cmsraudt0003_list_SELECT ()
{
    /*
    <LOGIC>
    - 컴파일 에러로 수정하였음.
    임의수정 하면 안됨.
    </LOGIC>
    */
    EXEC SQL DECLARE CURS1_5000 CURSOR FOR
		SELECT
			/*+ FULL(A) */
			A.ROWID,
			CASE
				WHEN A.DBNTR_CTGCD = 'SKT' THEN B.SGNAS_CODE
				ELSE SUBSTR(A.TRSCP_DBNNO, 1, 1)
			END SGNAS_CODE, /* 채권종류코드 A3 등 */
			A.CSTMR_DVSCD,
			A.DBNTR_CTGCD,
			A.CSTNO,
			A.TRSCP_DVSCD,
			A.DBNNO,
			A.CSTMR_NAME,
			A.DBTNM,
			A.FNSDT,
			A.FIRST_ACADT,
			A.DBTR_RLTCD,
			A.DEL_YN,
			A.TRSCP_DBNNO
		FROM
			MSRAUDT01MT A,
            MSRCRDT01VT B
		WHERE
			A.FIRST_RGSDM >= TO_DATE(:hv_rgsdt, 'YYYYMMDD')
		AND A.FIRST_RGSDM <  TO_DATE(:hv_rgsdt, 'YYYYMMDD') + 1
		AND A.WORKDT IS NULL
		AND A.DBNTR_CTGCD IN ('SKT')
        AND A.DBNNO = B.DBNNO(+)
        AND B.DATA_STTCD(+) = '1'
	;

    EXEC SQL OPEN CURS1_5000;
    if (SQLCODE != SQL_OK) {
        printf("CURS1_5000 OPEN ERROR [%d][%s]\n", SQLCODE, SQLERRM);
        fprintf(out, "CURS1_5000 OPEN ERROR [%d][%s]\n", SQLCODE, SQLERRM);
        return FAILURE;
    }

    for (jj=0;;jj++) {
		VCHINIT(hv_rowid ); 
		VCHINIT(hv_cstmr_dvscd );
        VCHINIT(hv_dbntr_ctgcd ); 
        VCHINIT(hv_dbnno  ); 
        VCHINIT(hv_cstmr_name); 
		VCHINIT(hv_mbdb_name); 
		VCHINIT(hv_first_acadt); 
		VCHINIT(hv_dbtr_rltname); 
        VCHINIT(hv_cstno); 
		VCHINIT(hv_trscp_dvscd); 
        VCHINIT(hv_fnsdt); 
		VCHINIT(hv_del_yn); 
		
        VCHINIT(hv_sndng_date); 
        VCHINIT(hv_cnslt_date); 
        VCHINIT(hv_cnslt_gubn); 
        VCHINIT(hv_recv_emid_name);
        VCHINIT(hv_rgytr_rgino); 
        VCHINIT(hv_ntytf_rsn_cntnt); 
		VCHINIT(hv_trscp_dbnno);
        VCHINIT(hv_sgnas_code); 

		EXEC SQL FETCH CURS1_5000 INTO
			:hv_rowid,
			:hv_sgnas_code,
			:hv_cstmr_dvscd,	:hv_dbntr_ctgcd,	:hv_cstno,  	:hv_trscp_dvscd,
			:hv_dbnno, 			:hv_cstmr_name,		:hv_mbdb_name,	:hv_fnsdt,
			:hv_first_acadt,	:hv_dbtr_rltname,	:hv_del_yn,		:hv_trscp_dbnno;
            
		if (SQLCODE == SQL_NO_DATA) {
			break;
        } else if (SQLCODE != SQL_OK) {
			printf ("cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			fprintf(out,"cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			EXEC SQL CLOSE CURS1_5000;
            EXEC SQL ROLLBACK;
			return FAILURE;
        }

        if (jj < 10) {
            printf("%d 진행중....\n", jj);
        }

		l_tot_cnt++;
        if (l_tot_cnt % 100 == 0) {
			CHRINIT(buf); common_gettime(buf,":");
			printf ("cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
			fprintf (out,"cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
        }


        /*
        <LOGIC>
        - 아래의 수임안내 발송일 추출은 해당 채권, 혹은 해당 채권의 전환 이전 채권을 대상으로 한다.
        - 추심을 위한 채권카드 화면에서 발송 및 영업일 경과 여부를 체크하는것은 해당 채권 수임일자 이후 최초 발송일자를 대상으로한다.
        - 따라서 이를 위한 발송일도 채번하려한다.
        - VCHINIT, 변수 및 배열 선언, sqlcode 대응 부탁
        </LOGIC>
        */
        EXEC SQL
            SELECT
                POST_SNDNG_DATE, DBNNO
            INTO
                :hv_card_post_sndng_date,
                :card_sndng_dbnno
            FROM
                (
                SELECT
                    POST_SNDNG_DATE, STNDY, DBNNO
                FROM
                    MSRURSN01MT A
                WHERE
                    A.DATA_STTCD = '1'
                AND TRSCP_DVSCD = :hv_trscp_dvscd
                AND CSTNO = :hv_cstno
                AND STNDY >= :hv_first_acadt
                AND INSTR_STGCD = '01'
                AND POST_SNDNG_DATE IS NOT NULL
                ORDER BY
                    POST_SNDNG_DATE
                )
            WHERE
                ROWNUM = 1 
        ;



/* <TO-BE> */
        /*
        <LOGIC>
        [컴파일 에러 대응 및 윈도우 함수 제거]
        Pro*C 하위 버전에서는 인라인 뷰 내에서 분석 함수 (ROW_NUMBER() OVER) 사용 시 파싱 에러(Compilation Error)가 발생할 수 있습니다.
        이를 해결하기 위해, 인라인 뷰 내부에서 `ORDER BY`를 사용하고 바깥쪽 쿼리에서 `WHERE ROWNUM = 1`로 첫 번째 행만 추출하는 
        표준 정적 SQL 형태로 모두 변경하였습니다.
        또한, ORA-01405(NULL fetch) 방지를 위해 MIN 함수에 NVL 처리를 보강하였습니다.
        </LOGIC>
        */
        VCHINIT(hv_old_dbnno);
        VCHINIT(hv_old_first_acadt);
        
        if (strcmp(hv_dbntr_ctgcd.arr, "SKT") == 0) {
			if (strcmp(hv_sgnas_code.arr, "A3") == 0) {
				/* 특수채권 처리 (A3) */
                
                /*
                <LOGIC>
                - 채권 중 가장 오래된 수임채권 정보를 가져온다.
                - 아래에 SQLCODE 대응 로직 추가 필요
                </LOGIC>
                */
                EXEC SQL
                    SELECT
                        DBNNO,
                        ACPAP_DATE
                    INTO
                        :hv_old_dbnno,
                        :hv_old_first_acadt
                    FROM
                        (
                        SELECT
                            DBNNO,
                            ACPAP_DATE 
                        FROM MSRACCP01MT 
                        WHERE DATA_STTCD = '1' 
                        AND CMISS_DVSCD != 'A3' 
                        AND SRVC_MNGNO = :hv_trscp_dbnno
                        UNION ALL
                        SELECT :hv_dbnno DBNNO, :hv_first_acadt ACPAP_DATE FROM DUAL
                        ORDER BY ACPAP_DATE
                        )
                    WHERE
                        ROWNUM = 1
                ;
                
                if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                    printf("MSRACCP01MT SELECT ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    fprintf(out, "MSRACCP01MT SELECT ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    EXEC SQL CLOSE CURS1_5000;
                    EXEC SQL ROLLBACK;
                    return FAILURE;
                }

                i_ck_cnt = 0;
                VCHINIT(hv_cnslt_date);
                
                EXEC SQL            
                    SELECT COUNT(*), NVL(MIN(CNSLT_DATE), ' ')
                    INTO :i_ck_cnt, :hv_cnslt_date
                    FROM MSRCSPR01MT A
                    WHERE TRSCP_DVSCD = :hv_trscp_dvscd
                      AND NVL(GRNTR_CSTNO, CSTNO) = :hv_cstno
                      AND A.DBNNO IN (
                          SELECT DBNNO 
                          FROM MSRACCP01MT 
                          WHERE DATA_STTCD = '1' 
                            AND CMISS_DVSCD != 'A3' 
                            AND SRVC_MNGNO = :hv_trscp_dbnno
                          UNION ALL
                          SELECT :hv_dbnno FROM DUAL
                      )
                      AND A.DATA_STTCD = '1'
                      AND A.AZTN_DVSCD IN ('B3','B4','B1','C1','C2','C3','B5')
                      AND NOT ( 
                          A.AZTN_DVSCD IN ('B4', 'B3')
                          AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR
                              (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR
                              (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01'))
                          AND A.PRMAM = 0)
                      AND RTRN_CODE IS NULL
                      AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%');
                      
                if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                    printf("MSRCSPR01MT COUNT/MIN ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    fprintf(out, "MSRCSPR01MT COUNT/MIN ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    EXEC SQL CLOSE CURS1_5000;
                    EXEC SQL ROLLBACK;
                    return FAILURE;
                }

                if (i_ck_cnt > 0) {
                    VCHINIT(hv_cnslt_gubn);
                    VCHINIT(hv_recv_emid);
                    VCHINIT(hv_cnslt_cntnt);

                    /* 윈도우 함수(ROW_NUMBER) 대신 ORDER BY + ROWNUM = 1 로 우회 */
                    EXEC SQL
                        SELECT CNSLT_GUBN, PRINC_EMINO, SUBSTR(CNSLT_CNTNT, 1, 400)
                        INTO :hv_cnslt_gubn, :hv_recv_emid, :hv_cnslt_cntnt
                        FROM (
                            SELECT 
                                CASE 
                                    WHEN AZTN_DVSCD IN ('B3','B4') THEN 'DM' 
                                    WHEN AZTN_DVSCD IN ('B1','C1','C2','C3') THEN '전화' 
                                    WHEN AZTN_DVSCD IN ('B5') THEN 'SMS' 
                                    ELSE '기타' 
                                END CNSLT_GUBN,
                                PRINC_EMINO, 
                                NVL(CNSLT_CNTNT, ' ') CNSLT_CNTNT
                            FROM MSRCSPR01MT A
                            WHERE TRSCP_DVSCD = :hv_trscp_dvscd
                              AND NVL(GRNTR_CSTNO, CSTNO) = :hv_cstno
                              AND A.DBNNO IN (
                                  SELECT DBNNO 
                                  FROM MSRACCP01MT 
                                  WHERE DATA_STTCD = '1' 
                                    AND CMISS_DVSCD != 'A3' 
                                    AND SRVC_MNGNO = :hv_trscp_dbnno
                                  UNION ALL
                                  SELECT :hv_dbnno FROM DUAL
                              )
                              AND A.DATA_STTCD = '1'
                              AND A.AZTN_DVSCD IN ('B3', 'B4', 'B1', 'C1', 'C2', 'C3', 'B5')
                              AND NOT (
                                  A.AZTN_DVSCD IN ('B4', 'B3')
                                  AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR
                                      (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR
                                      (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01'))
                                  AND A.PRMAM = 0)
                              AND RTRN_CODE IS NULL
                              AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%')
                            ORDER BY CNSLT_DATE ASC, FIRST_RGSDM ASC
                        )
                        WHERE ROWNUM = 1;
                        
                    if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                        printf("MSRCSPR01MT ROWNUM=1 ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                        EXEC SQL CLOSE CURS1_5000;
                        EXEC SQL ROLLBACK;
                        return FAILURE;
                    }

                    VCHINIT(hv_recv_emid_name);
                    EXEC SQL
                        SELECT EMPLY_KRNNM INTO :hv_recv_emid_name
                        FROM MHREMPL01MT WHERE EMINO = :hv_recv_emid;
                        
                    if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                        printf("MHREMPL01MT ERROR [%d][%s]\n", SQLCODE, SQLERRM);
                        EXEC SQL CLOSE CURS1_5000; return FAILURE;
                    }

                    VCHINIT(hv_rgytr_rgino);
                    EXEC SQL
                        SELECT TRIM(SUBSTR(RGYTR_RGINO,1,12)) INTO :hv_rgytr_rgino
                        FROM MHREMPL09MT WHERE EMINO = :hv_recv_emid;
                        
                    if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                        printf("MHREMPL09MT ERROR [%d][%s]\n", SQLCODE, SQLERRM);
                        EXEC SQL CLOSE CURS1_5000; return FAILURE;
                    }
                }

                VCHINIT(hv_sndng_date);
                VCHINIT(hv_stndy);
                VCHINIT(hv_sndng_dbnno);
                
                EXEC SQL
                    SELECT DBNNO, NVL(POST_SNDNG_DATE, ' '), NVL(STNDY, ' ')
                    INTO :hv_sndng_dbnno, :hv_sndng_date, :hv_stndy
                    FROM (	
                        SELECT DBNNO, POST_SNDNG_DATE, STNDY
                        FROM MSRURSN01MT
                        WHERE TRSCP_DVSCD = :hv_trscp_dvscd
                          AND CSTNO = :hv_cstno
                          AND DBNNO IN (
                              SELECT DBNNO 
                              FROM MSRACCP01MT 
                              WHERE DATA_STTCD = '1' 
                                AND CMISS_DVSCD != 'A3' 
                                AND SRVC_MNGNO = :hv_trscp_dbnno
                              UNION ALL
                              SELECT :hv_dbnno FROM DUAL
                          )
                          AND INSTR_STGCD = '01'
                        ORDER BY FIRST_RGSDM ASC
                    )
                    WHERE ROWNUM = 1;
                    
                if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                    printf("MSRURSN01MT ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    EXEC SQL CLOSE CURS1_5000;
                    EXEC SQL ROLLBACK;
                    return FAILURE;
                }

			} else {
                /* 일반 SKT 채권 처리 */
                i_ck_cnt = 0;
                VCHINIT(hv_cnslt_date);
                
                EXEC SQL            
                    SELECT COUNT(*), NVL(MIN(CNSLT_DATE), ' ')
                    INTO :i_ck_cnt, :hv_cnslt_date
                    FROM MSRCSPR01MT A
                    WHERE TRSCP_DVSCD = :hv_trscp_dvscd
                      AND NVL(GRNTR_CSTNO, CSTNO) = :hv_cstno
                      AND A.DBNNO = :hv_dbnno
                      AND A.DATA_STTCD = '1'
                      AND A.AZTN_DVSCD IN ('B3','B4','B1','C1','C2','C3','B5')
                      AND NOT ( 
                          A.AZTN_DVSCD IN ('B4', 'B3')
                          AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR
                              (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR
                              (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01'))
                          AND A.PRMAM = 0)
                      AND RTRN_CODE IS NULL
                      AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%');
                      
                if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                    printf("MSRCSPR01MT COUNT/MIN (Normal) ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    EXEC SQL CLOSE CURS1_5000; EXEC SQL ROLLBACK; return FAILURE;
                }

                if (i_ck_cnt > 0) {
                    VCHINIT(hv_cnslt_gubn);
                    VCHINIT(hv_recv_emid);
                    VCHINIT(hv_cnslt_cntnt);

                    /* 윈도우 함수 제거 후 ORDER BY + ROWNUM=1 로 수정 */
                    EXEC SQL
                        SELECT CNSLT_GUBN, PRINC_EMINO, SUBSTR(CNSLT_CNTNT, 1, 400)
                        INTO :hv_cnslt_gubn, :hv_recv_emid, :hv_cnslt_cntnt
                        FROM (
                            SELECT 
                                CASE 
                                    WHEN AZTN_DVSCD IN ('B3','B4') THEN 'DM' 
                                    WHEN AZTN_DVSCD IN ('B1','C1','C2','C3') THEN '전화' 
                                    WHEN AZTN_DVSCD IN ('B5') THEN 'SMS' 
                                    ELSE '기타' 
                                END CNSLT_GUBN,
                                PRINC_EMINO, 
                                NVL(CNSLT_CNTNT, ' ') CNSLT_CNTNT
                            FROM MSRCSPR01MT A
                            WHERE TRSCP_DVSCD = :hv_trscp_dvscd
                              AND NVL(GRNTR_CSTNO, CSTNO) = :hv_cstno
                              AND A.DBNNO = :hv_dbnno
                              AND A.DATA_STTCD = '1'
                              AND A.AZTN_DVSCD IN ('B3', 'B4', 'B1', 'C1', 'C2', 'C3', 'B5')
                              AND NOT ( 
                                  A.AZTN_DVSCD IN ('B4', 'B3')
                                  AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR
                                      (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR
                                      (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01'))
                                  AND A.PRMAM = 0)
                              AND RTRN_CODE IS NULL
                              AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%')
                            ORDER BY CNSLT_DATE ASC, FIRST_RGSDM ASC
                        )
                        WHERE ROWNUM = 1;
                        
                    if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                        printf("MSRCSPR01MT ROWNUM=1 (Normal) ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                        EXEC SQL CLOSE CURS1_5000; EXEC SQL ROLLBACK; return FAILURE;
                    }

                    VCHINIT(hv_recv_emid_name);
                    EXEC SQL
                        SELECT EMPLY_KRNNM INTO :hv_recv_emid_name
                        FROM MHREMPL01MT WHERE EMINO = :hv_recv_emid;
                        
                    if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                        printf("MHREMPL01MT (Normal) ERROR [%d][%s]\n", SQLCODE, SQLERRM);
                        EXEC SQL CLOSE CURS1_5000; return FAILURE;
                    }

                    VCHINIT(hv_rgytr_rgino);
                    EXEC SQL
                        SELECT TRIM(SUBSTR(RGYTR_RGINO,1,12)) INTO :hv_rgytr_rgino
                        FROM MHREMPL09MT WHERE EMINO = :hv_recv_emid;
                        
                    if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                        printf("MHREMPL09MT (Normal) ERROR [%d][%s]\n", SQLCODE, SQLERRM);
                        EXEC SQL CLOSE CURS1_5000; return FAILURE;
                    }
                }

                VCHINIT(hv_sndng_date);
                VCHINIT(hv_stndy);
                VCHINIT(hv_sndng_dbnno);
                
                EXEC SQL
                    SELECT DBNNO, NVL(POST_SNDNG_DATE, ' '), NVL(STNDY, ' ')
                    INTO :hv_sndng_dbnno, :hv_sndng_date, :hv_stndy
                    FROM (	
                        SELECT DBNNO, POST_SNDNG_DATE, STNDY
                        FROM MSRURSN01MT
                        WHERE TRSCP_DVSCD = :hv_trscp_dvscd
                          AND CSTNO = :hv_cstno
                          AND DBNNO = :hv_dbnno
                          AND POST_SNDNG_DATE IS NOT NULL
                          AND INSTR_STGCD = '01'
                          AND STNDY >= :hv_first_acadt
                        ORDER BY FIRST_RGSDM ASC
                    )
                    WHERE ROWNUM = 1;
                    
                if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
                    printf("MSRURSN01MT (Normal) ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
                    EXEC SQL CLOSE CURS1_5000; EXEC SQL ROLLBACK; return FAILURE;
                }
            }
		}
/* </TO-BE> */

        /*===============================================================*/
        /* 6.미발송사유													 */
        /*===============================================================*/
        VCHINIT(hv_ntytf_rsn_cntnt);
        EXEC SQL			
            SELECT NVL(replace(replace(CNSLT_CNTNT,CHR(10),''),chr(13),''), ' ')
            INTO :hv_ntytf_rsn_cntnt
            FROM (
                SELECT CNSLT_CNTNT
                FROM MSRCSPR01MT
                WHERE CSTNO = :hv_cstno
                  AND DBNNO = :hv_dbnno
                  AND TRSCP_DVSCD = :hv_trscp_dvscd
                  AND CNSLT_DATE >= :hv_first_acadt
                  AND AZTN_DVSCD = 'B9'
                  AND DATA_STTCD = '1'
                UNION ALL
                SELECT CNSLT_CNTNT
                FROM MSRCSPR01MT
                WHERE GRNTR_CSTNO = :hv_cstno
                  AND DBNNO = :hv_dbnno
                  AND TRSCP_DVSCD = :hv_trscp_dvscd
                  AND CNSLT_DATE >= :hv_first_acadt
                  AND AZTN_DVSCD = 'B9'
                  AND DATA_STTCD = '1'
            )
            WHERE ROWNUM = 1;

        if (SQLCODE != SQL_OK && SQLCODE != SQL_NO_DATA) {
            printf("MSRCSPR01MT(B9) ERROR [%d][%s] DBNNO:[%s]\n", SQLCODE, SQLERRM, hv_dbnno.arr);
            EXEC SQL CLOSE CURS1_5000; EXEC SQL ROLLBACK; return FAILURE;
        }

        /*===============================================================*/
        /* 7.테이블에 작성												 */
        /*===============================================================*/
        memset(arr_rowid[arr_idx], 0x00, 51);
        strncpy(arr_rowid[arr_idx], (char *)hv_rowid.arr, hv_rowid.len);
        
        memset(arr_sndng_date[arr_idx], 0x00, 10);
        strncpy(arr_sndng_date[arr_idx], (char *)hv_sndng_date.arr, hv_sndng_date.len);
        
        memset(arr_cnslt_date[arr_idx], 0x00, 10);
        strncpy(arr_cnslt_date[arr_idx], (char *)hv_cnslt_date.arr, hv_cnslt_date.len);

        memset(arr_hv_stndy[arr_idx], 0x00, 10);
        strncpy(arr_hv_stndy[arr_idx], (char *)hv_stndy.arr, hv_stndy.len);

        memset(arr_cnslt_gubn[arr_idx], 0x00, 25);
        strncpy(arr_cnslt_gubn[arr_idx], (char *)hv_cnslt_gubn.arr, hv_cnslt_gubn.len);
        
        memset(arr_recv_emid_name[arr_idx], 0x00, 25);
        strncpy(arr_recv_emid_name[arr_idx], (char *)hv_recv_emid_name.arr, hv_recv_emid_name.len);
        
        memset(arr_rgytr_rgino[arr_idx], 0x00, 35);
        strncpy(arr_rgytr_rgino[arr_idx], (char *)hv_rgytr_rgino.arr, hv_rgytr_rgino.len);
        
        memset(arr_ntytf_rsn_cntnt[arr_idx], 0x00, 55);
        strncpy(arr_ntytf_rsn_cntnt[arr_idx], (char *)hv_ntytf_rsn_cntnt.arr, hv_ntytf_rsn_cntnt.len);

        memset(arr_sndng_dbnno[arr_idx], 0x00, 15);
        strncpy(arr_sndng_dbnno[arr_idx], (char *)hv_sndng_dbnno.arr, hv_sndng_dbnno.len);

        memset(arr_cnslt_cntnt[arr_idx], 0x00, 405);
        strncpy(arr_cnslt_cntnt[arr_idx], (char *)hv_cnslt_cntnt.arr, hv_cnslt_cntnt.len);
        
        /* [추가] 새로운 업데이트 칼럼 3개에 대한 배열 복사 처리 */
        memset(arr_sgnas_code[arr_idx], 0x00, 25);
        strncpy(arr_sgnas_code[arr_idx], (char *)hv_sgnas_code.arr, hv_sgnas_code.len);
        
        memset(arr_old_dbnno[arr_idx], 0x00, 15);
        strncpy(arr_old_dbnno[arr_idx], (char *)hv_old_dbnno.arr, hv_old_dbnno.len);
        
        memset(arr_old_first_acadt[arr_idx], 0x00, 10);
        strncpy(arr_old_first_acadt[arr_idx], (char *)hv_old_first_acadt.arr, hv_old_first_acadt.len);

        arr_idx++;
        if (arr_idx == ARRAY_SIZE) {
            h_update_cnt = arr_idx;
            /* FOR 구문을 사용하여 5000건을 단 1번의 쿼리로 UPDATE */
            /*
            <LOGIC>
            - 업데이트 칼럼 추가.
            추가된 칼럼을 임의로 삭제하면 안됨
            - 또한 미존재시 너가 자동으로 배열 및 개별 바인딩 변수 생성해줘야함.
            </LOGIC>
            */
            EXEC SQL FOR :h_update_cnt
                UPDATE MSRAUDT01MT
                SET WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
                    
                    CNSLT_DATE = :arr_cnslt_date,
                    CNSLT_GUBN = :arr_cnslt_gubn,
                    RECV_EMID_NAME = :arr_recv_emid_name,
                    RGYTR_RGINO = :arr_rgytr_rgino,
                    CNSLT_CNTNT = :arr_cnslt_cntnt,
                    NTYTF_RSN_CNTNT = :arr_ntytf_rsn_cntnt,
                    SGNAS_CODE = :arr_sgnas_code,
                    -- 전환이전/후 채권들 중 최초 발송일
                    SNDNG_DBNNO = :arr_sndng_dbnno,
                    SNDNG_DATE = :arr_sndng_date,
                    STNDY = :arr_hv_stndy,
                    -- 전환 이전 채권 정보
                    OLD_DBNNO = :arr_old_dbnno,
                    OLD_FIRST_ACADT = :arr_old_first_acadt,
                    -- 종합상담 인정
                    CARD_POST_SNDNG_DATE = :arr_card_post_sndng_date,
                    CARD_SNDNG_DBNNO = :arr_card_sndng_dbnno
                    
                WHERE ROWID = :arr_rowid;
                
            if (SQLCODE != SQL_OK) {
                printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
                fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
                EXEC SQL CLOSE CURS1_5000;
                EXEC SQL ROLLBACK;
                return FAILURE;
            }

            arr_idx = 0; /* 업데이트 완료 후 인덱스 초기화 */
        }
    }

    /* 남은 자투리 데이터가 있다면 마지막 일괄 UPDATE 수행 */
    /*
    <LOGIC>
    - 업데이트 칼럼 추가.
    추가된 칼럼을 임의로 삭제하면 안됨
    - 또한 미존재시 너가 자동으로 배열 및 개별 바인딩 변수 생성해줘야함.
    </LOGIC>
    */
    if (arr_idx > 0) {
        h_update_cnt = arr_idx;
        EXEC SQL FOR :h_update_cnt
            UPDATE MSRAUDT01MT
            SET WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
                    
                CNSLT_DATE = :arr_cnslt_date,
                CNSLT_GUBN = :arr_cnslt_gubn,
                RECV_EMID_NAME = :arr_recv_emid_name,
                RGYTR_RGINO = :arr_rgytr_rgino,
                CNSLT_CNTNT = :arr_cnslt_cntnt,
                NTYTF_RSN_CNTNT = :arr_ntytf_rsn_cntnt,
                SGNAS_CODE = :arr_sgnas_code,
                -- 전환이전/후 채권들 중 최초 발송일
                SNDNG_DBNNO = :arr_sndng_dbnno,
                SNDNG_DATE = :arr_sndng_date,
                STNDY = :arr_hv_stndy,
                -- 전환 이전 채권 정보
                OLD_DBNNO = :arr_old_dbnno,
                OLD_FIRST_ACADT = :arr_old_first_acadt,
                -- 종합상담 인정
                CARD_POST_SNDNG_DATE = :arr_card_post_sndng_date,
                CARD_SNDNG_DBNNO = :arr_card_sndng_dbnno
            WHERE ROWID = :arr_rowid;
            
        if (SQLCODE != SQL_OK) {
            printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
            fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
            EXEC SQL CLOSE CURS1_5000;
            EXEC SQL ROLLBACK;
            return FAILURE;
        }
    }

    EXEC SQL CLOSE CURS1_5000;
    return SUCCESS;
}
/*==========================================================================*/
/* END OF SOURCE                               */
/*==========================================================================*/
