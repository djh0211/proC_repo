#include <stdio.h>
#include <stdlib.h>
/*#include <macros.h>*/
#include <macro.h>

#include "xdsp_type.h"
#include "xdsp_util.h"
#include "xdsp_parser.h"
#include "xdsp_tcp.h"
#include "xdsp_api.h"
#include "xdsp_api_err.h"

#define ARRAY_SIZE 5000  /* 한 번에 업데이트할 건수 */


static      long        l_tot_cnt;
/*==========================================================================*/
/*함수 프로토타입 선언                     		                            */
/*==========================================================================*/
int  cmsraudt0001_list_SELECT_5000 ();
int  cmsraudt0001_list_SELECT ();
/*==========================================================================*/
/* 전역변수 선언( FML Buffer Pointer, HOST변수 )	                        */
/*==========================================================================*/
static		FILE		*out,*o_fp;
char	c_commands [124];

EXEC SQL BEGIN     DECLARE SECTION ;

/*==========================================================================*/
/*    TABLE 명  : MSRCRDT01MT(채권)                                         */
/*==========================================================================*/
static      varchar     hv_stml_date      [9];  
static      varchar     hv_gubun		  [3];
static      varchar     hv_rgsdt		  [9];

static      varchar     hv_rowid	      [51]; /* ROWID			*/
static      varchar     hv_cstmr_dvscd	  [11]; /* 개인/법인구분			*/
static      varchar     hv_dbntr_ctgcd	  [11]; /* 채권종류					*/
static      varchar     hv_dbnno          [11]; /* 채권번호                 */
static      varchar     hv_sndng_dbnno    [11]; /* 수임안내문나간채권번호                 */
static      varchar     hv_cstmr_name     [41]; /* 성명						*/
static      varchar     hv_mbdb_name      [41]; /* 주채무자명	  			*/
static      varchar     hv_dbtr_rltname   [4]; /* 관계구분	  			*/
static      varchar     hv_first_acadt    [9];  /* 수임일자					*/
static      varchar     hv_sndng_date     [9];  /* 채권수임안내문발송일자	*/
static      varchar     hv_cnslt_date     [9];  /* 최초추심활동일자	        */
static      varchar     hv_stndy     	  [9];  /* 최초추심활동일자	        */
static      varchar     hv_cnslt_gubn     [21]; /* 최초추심활동방법	        */
static      varchar     hv_recv_emid      [8];  /* 담당자사번				*/
static      varchar     hv_recv_emid_name [21]; /* 담당자명					*/
static      varchar     hv_rgytr_rgino    [31]; /* 담당 협회등록번호(2012.05. kjy)	*/
static      varchar     hv_cstno          [11]; /* 고객번호-참고항목                 */
static      varchar     hv_fnsdt          [9];  /* 완결일자-참고항목                 */
static      varchar     hv_fnsh_dvscd     [3];  /* 완결구분-참고항목                 */
static      varchar		hv_ntytf_rsn_cntnt [51]; /*미발송사유-참고항목               */
static      varchar     hv_trscp_dvscd     [5];  /*위임사-참고항목                   */
static      varchar     hv_del_yn     	   [2];  /*보증인삭제여부-참고항목           */
static 		varchar		hv_cnslt_cntnt	  [401];

static      varchar     hv_trscp_dbnno     [41]; /* 위임사채권번호						*/
static		varchar		sql_stmt [60000];



/* 일괄 UPDATE를 위한 배열 호스트 변수 선언 (넉넉하게 사이즈 할당) */
static		char 		arr_rowid          [ARRAY_SIZE][51];
static		char 		arr_sndng_date     [ARRAY_SIZE][10];
static		char 		arr_cnslt_date     [ARRAY_SIZE][10];
static		char 		arr_hv_stndy     [ARRAY_SIZE][10];
static		char 		arr_cnslt_gubn     [ARRAY_SIZE][25];
static		char 		arr_recv_emid_name [ARRAY_SIZE][25];
static		char 		arr_rgytr_rgino    [ARRAY_SIZE][35];
static		char 		arr_ntytf_rsn_cntnt[ARRAY_SIZE][55];
static		char 		arr_sndng_dbnno    [ARRAY_SIZE][15];
static 		char		arr_cnslt_cntnt	   [ARRAY_SIZE][405];





static 		int  		h_update_cnt;  /* 실제 업데이트될 건수를 담을 호스트 변수 */

/* Oracle User */
static varchar hv_userid    [20];
static varchar hv_passwd    [20];

EXEC SQL    END         DECLARE SECTION ;
int   i_sequ[40001],Main_rtn;
char  buf[21];
char  c_buffer[1001];
int   tot_scan,tot_fnsh,tot_zip_fail,tot_3,tot_0,tot_insert,rtn,ii,t_cust_cnt,
	  t_stml_cnt,jj,dm_cnt,hm_cnt, ps_cnt,hd_cnt ;
int   i_ck_cnt=0;
int	  arr_idx = 0;

EXEC SQL    INCLUDE     sqlca.h ;

/*==========================================================================*/
/*          서비스 Main Process 함수                                        */
/*              1. 서비스명 기술                                            */
/*              2. Client로부터 전송된 데이타 수신                          */
/*              3. 입력 데이타 처리 함수(FML ==> Host)                      */
/*              4. 입력 테이타 체크 처리 함수                               */
/*              5. 데이타베이스 처리 및 출력 처리 함수                      */
/*==========================================================================*/
void main (int argc,char *argv[])
{


    if (ora_init() ==  FAILURE) {
        printf("cmsraudt0001_list-CONNECT ERROR [%d][%s] \n", SQLCODE, SQLERRM );
        exit (-1) ;
    }

    if (argc == 3) {
        VCHINIT(hv_gubun);
        STR2VCH(hv_gubun,argv[1]);

		VCHINIT(hv_rgsdt);
        STR2VCH(hv_rgsdt,argv[2]);

        if (hv_gubun.len != 2) {
            printf("/*==================================================*/\n");
            printf("/*  Ex) cmsraudt0001_list 01 20260327               */\n");
            printf("/*==================================================*/\n");
            exit(-1);
        }
		if (hv_rgsdt.len != 8) {
            printf("/*==================================================*/\n");
            printf("/*  Ex) cmsraudt0001_list 01 20260327               */\n");
            printf("/*==================================================*/\n");
            exit(-1);
        }
        if ((strcmp(hv_gubun.arr , "01") != 0) &&
            (strcmp(hv_gubun.arr , "02") != 0) &&
            (strcmp(hv_gubun.arr , "03") != 0)) {
            printf("/*=========================================================*/\n");
            printf("/*  Ex) 인자값을 확인하세요                                */\n");
            printf("/*      [01:5000건 테스트]      */\n");
            printf("/*=========================================================*/\n");
            exit(-1);
        }

    }
    else {
        printf("/*==================================================*/\n");
        printf("/*  Ex) cmsraudt0001_list 01                       */\n");
        printf("/*==================================================*/\n");
        exit(-1);
    }

	memset(c_commands , 0x00, sizeof(c_commands));
	strcat(c_commands, "audit/cmsraudt0001_list.log");

    if ((out = fopen(c_commands,"a")) == NULL) {
        printf("LOG FILE OPEN ERROR\n");
        exit(-1);
    }

	VCHINIT(hv_stml_date);
    EXEC SQL
        SELECT TO_CHAR(SYSDATE,'yyyymmdd')
        INTO   :hv_stml_date
        FROM   DUAL;


	CHRINIT(buf); common_gettime(buf,":");
	printf ("\n\n",hv_stml_date.arr,buf);
    fprintf (out,"\n\n",hv_stml_date.arr,buf);
    printf ("금감원 자료 추출 START : [%s][%s]\n",hv_stml_date.arr,buf);
    fprintf (out,"금감원 자료 추출 START : [%s][%s]\n",hv_stml_date.arr,buf);

	
 	/*** 01 : 1968  *********************************************/
    if (strcmp(hv_gubun.arr, "01") == 0) {

    	if (cmsraudt0001_list_SELECT_5000 () == FAILURE) {
			EXEC SQL ROLLBACK;
        	fclose(out);
        	exit (-1) ;
    	} 

	} else if (strcmp(hv_gubun.arr, "02") == 0) {

    	if (cmsraudt0001_list_SELECT () == FAILURE) {
			EXEC SQL ROLLBACK;
        	fclose(out);
        	exit (-1) ;
    	} 

	}

	CHRINIT(buf); common_gettime(buf,":");
    printf ("금감원 자료 추출 END : [%s][%s]\n",hv_stml_date.arr,buf);
    fprintf (out,"금감원 자료 추출 END : [%s][%s]\n",hv_stml_date.arr,buf);

	EXEC SQL COMMIT;



	fclose(out);
    exit (0);
}



/*==========================================================================*/
/* 함 수 명 : int cmsraudt0001_list_SELECT_5000()        					*/
/* 파라메터 : 없음                                                          */
/* 설    명 : Database 처리            	            			            */
/* 리 턴 값 : 성공시 SUCCESS(0), 실패시 FAILURE(-1)                         */
/*==========================================================================*/
int cmsraudt0001_list_SELECT_5000 ()
{
	/*---------------------------------------------------------------*/
	/* 추출대상 올리기 											 	 */
	/*---------------------------------------------------------------*/
    EXEC SQL DECLARE CURS1_5000 CURSOR FOR
		SELECT
			/*+ FULL(A) */
			ROWID,
			
			CSTMR_DVSCD,
			DBNTR_CTGCD,
			CSTNO,
			TRSCP_DVSCD,
			DBNNO,
			CSTMR_NAME,
			DBTNM,
			FNSDT,
			FIRST_ACADT,
			DBTR_RLTCD,
			DEL_YN,
			TRSCP_DBNNO
		FROM    
			MSRAUDT01MT A
		WHERE   
			FIRST_RGSDM >= TO_DATE(:hv_rgsdt, 'YYYYMMDD')
		AND FIRST_RGSDM <  TO_DATE(:hv_rgsdt, 'YYYYMMDD') + 1
		AND WORKDT IS NULL
		-- AND ROWNUM < 50000
	;

	EXEC SQL OPEN CURS1_5000;
	if (SQLCODE != SQL_OK) {
        printf("(CURS1_5000 OPEN) SELECT ERROR = [%d][%s]\n", SQLCODE, SQLERRM);
        fprintf(o_fp,"(CURS1_5000 OPEN) SELECT ERROR = [%d][%s]\n", SQLCODE, SQLERRM);
        EXEC SQL CLOSE CURS1_5000;
        return FAILURE;
    }

	
	VCHINIT(sql_stmt);
	sprintf((char *)sql_stmt.arr,
		"SELECT "
		"    CASE "
		"        WHEN AZTN_DVSCD IN ('B3','B4') THEN 'DM' "
		"        WHEN AZTN_DVSCD IN ('B1','C1','C2','C3') THEN '전화' "
		"        WHEN AZTN_DVSCD IN ('B5') THEN 'SMS' "
		"        ELSE '기타' "
		"    END CNSLT_GUBN, "
		"    PRINC_EMINO, "
		"    NVL(SUBSTR(CNSLT_CNTNT, 1, 400), ' ') " /* ORA-01405 방지용 NVL */
		"FROM "
		"    ( "
		"    SELECT "
		"        AZTN_DVSCD, "
		"        PRINC_EMINO, "
		"        CNSLT_CNTNT, "
		"        ROW_NUMBER() OVER(ORDER BY FIRST_RGSDM) RN "
		"    FROM     "
		"        MSRCSPR01MT A "
		"    WHERE    "
		"        TRSCP_DVSCD = :v1 " /* 바인드 변수 처리 */
		"    AND NVL(GRNTR_CSTNO, CSTNO) = :v2 "
		"    AND A.CNSLT_DATE >= :v3 "
		"    AND A.DBNNO = :v4 "
		"    AND A.DATA_STTCD = '1' "
		"    AND A.AZTN_DVSCD IN ('B3', 'B4', 'B1', 'C1', 'C2', 'C3', 'B5') "
		"    AND NOT (  "
		"            A.AZTN_DVSCD IN ('B4', 'B3') "
		"        AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR "
		"            (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR "
		"            (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01')) "
		"        AND A.PRMAM = 0) "
		"    AND RTRN_CODE IS NULL "
		"    AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%%') " /* C언어 포맷팅 이스케이프 */
		"    ) A "
		"WHERE "
		"    RN = 1 "
	);
	sql_stmt.len = strlen((char *)sql_stmt.arr);

	/* 3. 동적 SQL 파싱 및 실행 */
	EXEC SQL PREPARE select_stmt FROM :sql_stmt;
	EXEC SQL DECLARE cur_dyn_cnslt CURSOR FOR select_stmt;

    for (jj=0;;jj++) {
		VCHINIT(hv_rowid ); 	  /* ROWID		            */        
		VCHINIT(hv_cstmr_dvscd ); /* 개인/법인구분            */        
		VCHINIT(hv_dbntr_ctgcd ); /* 채권종류                 */
        VCHINIT(hv_dbnno  );      /* 채권번호                 */
        VCHINIT(hv_cstmr_name);   /* 채무자성명               */
		VCHINIT(hv_mbdb_name);    /* 주채무자성명               */		
		VCHINIT(hv_first_acadt);  /* 수임일자                 */
		VCHINIT(hv_dbtr_rltname);  /* 관계구분                 */
        VCHINIT(hv_cstno);        /* 고객번호-참고항목        */
		VCHINIT(hv_trscp_dvscd);  /*위임사-참고항목           */ 
        VCHINIT(hv_fnsdt);        /* 완결일자-참고항목        */
		VCHINIT(hv_del_yn);       /* 보증인삭제여부-참고항목        */
		
        VCHINIT(hv_sndng_date);  /* 채권수임안내문발송일자   */
        VCHINIT(hv_cnslt_date);  /* 최초추심활동일자         */
        VCHINIT(hv_cnslt_gubn); /* 최초추심활동방법         */        
        VCHINIT(hv_recv_emid_name);/* 담당자명                 */
        VCHINIT(hv_rgytr_rgino); /* 담당 협회등록번호  */
        VCHINIT(hv_ntytf_rsn_cntnt); /*미발송사유-참고항목               */
		VCHINIT(hv_trscp_dbnno); /* 위임사채권번호               */

		EXEC SQL FETCH CURS1_5000 INTO
			:hv_rowid,
			:hv_cstmr_dvscd,	:hv_dbntr_ctgcd,	:hv_cstno,  	:hv_trscp_dvscd,
			:hv_dbnno, 			:hv_cstmr_name,		:hv_mbdb_name,	:hv_fnsdt,
			:hv_first_acadt,	:hv_dbtr_rltname,	:hv_del_yn,		:hv_trscp_dbnno;

		if (SQLCODE == SQL_NO_DATA)
			break;
        else if (SQLCODE != SQL_OK) {
			printf ("cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			fprintf(out,"cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			EXEC SQL CLOSE CURS1_5000;
			return FAILURE;
        }

		l_tot_cnt++;

		if (l_tot_cnt % 100 == 0) {
			CHRINIT(buf); common_gettime(buf,":");
			printf ("cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
			fprintf (out,"cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
		}


		/*===============================================================*/
		/* 1.수임안내문 발송일    					           			 */
		/*===============================================================*/
        VCHINIT(hv_sndng_date);  /* 채권수임안내문발송일자   */
        VCHINIT(hv_sndng_dbnno); /* 수임안내문 나간 채권번호 */
        VCHINIT(hv_stndy); /* 수임안내문 기준일 */
		
		/*
		EXEC SQL
			SELECT
				SNDNG_DATE,
				STNDY,
				DBNNO
			INTO
				:hv_sndng_date,
				:hv_stndy,
				:hv_sndng_dbnno
			FROM
			   (SELECT
					aa.SNDDT SNDNG_DATE,
					aa.STNDY,
					aa.DBNNO DBNNO
				FROM
					MSRSMSS01MT aa, EM_MMT_LOG_TABLE bb
				WHERE
					'1501' = :hv_trscp_dvscd	
				AND	 aa.CSTNO = :hv_cstno
				AND  aa.DBNNO = :hv_dbnno
				AND  aa.SNDDT >= :hv_first_acadt
				AND  aa.TRSCP_DVSCD = :hv_trscp_dvscd  --해당위임사
				AND  aa.DATA_STTCD = '1'
				AND  aa.CSTNO = bb.MT_REFKEY
				AND  aa.SNDDT||substr(SNDNG_TIME,1,5) = substr(to_char(bb.DATE_CLIENT_REQ,'YYYYMMDDHH24MISS'),1,13)
				AND  aa.TRNSM_WRDS = bb.CONTENT
				AND  aa.TRNSM_WRDS_FRMCD = 'MMS99'
				AND  bb.SUBJECT = '채권 수임사실 통보서'
				and  nvl(MT_REPORT_CODE_IB,'9999') = '1000'
				AND  bb.SERVICE_TYPE = '2'   
				AND  bb.MSG_STATUS ='3'
				UNION ALL
				SELECT
					POST_SNDNG_DATE SNDNG_DATE,
					STNDY,
					DBNNO
				FROM 
					MSRURSN01MT 
				WHERE 
					TRSCP_DVSCD = :hv_trscp_dvscd
				and CSTNO = :hv_cstno
				and ( (TRSCP_DVSCD = '1501' AND (INSTR_STGCD = '01' OR INSTR_STGCD = '17') AND  DBNNO = :hv_dbnno ) OR    
					(TRSCP_DVSCD IN ('0901','0902','1701','1801','1803','1804','1901','1968') AND INSTR_STGCD = '01') OR      
					(TRSCP_DVSCD NOT IN ('0901','0902','1501','1701','1801','1803','1804','1901','1968') AND (INSTR_STGCD = '07' or INSTR_STGCD = '47') AND  DBNNO = :hv_dbnno) )
				and STNDY >= :hv_first_acadt
				ORDER BY SNDNG_DATE
			   ) A
			WHERE
				ROWNUM = 1
		;
		if (SQLCODE == SQL_NO_DATA) {
			strcpy(hv_sndng_date.arr, "");
			hv_sndng_date.len = strlen(hv_sndng_date.arr);
			strcpy(hv_sndng_dbnno.arr, "");
			hv_sndng_date.len = strlen(hv_sndng_dbnno.arr);
		} else if (SQLCODE != SQL_OK) {
			printf ("SNDNG_DATE_SELECT_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			fprintf(out,"SNDNG_DATE_SELECT_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			EXEC SQL CLOSE CURS1_5000;
			return FAILURE;
		}

		*/


		/*===============================================================*/
		/* 최초활동시작일자,방법             					         */
		/* 채무자/채권번호 조건 										 */
		/*===============================================================*/
		i_ck_cnt = 0;
		EXEC SQL			
			SELECT   
				COUNT(*), MIN(CNSLT_DATE)
			INTO
				:i_ck_cnt, :hv_cnslt_date
			FROM     
				MSRCSPR01MT A
			WHERE    
				TRSCP_DVSCD = :hv_trscp_dvscd
			AND NVL(GRNTR_CSTNO, CSTNO) = :hv_cstno
			AND A.CNSLT_DATE >= :hv_first_acadt    		
			AND A.DBNNO = :hv_dbnno
			AND A.DATA_STTCD = '1'
			AND A.AZTN_DVSCD IN ('B3',   --B3	안내문(일괄)		                                                          
								'B4',   --B4	안내문(개별)		                                                          
								'B1',	--B1	전화송신		                                                          
								'C1',	--C1	자택전화송신
								'C2',	--C2	직장전화송신
								'C3',	--C3	휴대폰송신
								'B5')	--B5	SMS발송
			AND	NOT ( 
				A.AZTN_DVSCD IN ('B4', 'B3')
			AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR
				 (A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR
				 (A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01'))
			AND A.PRMAM = 0)
			AND RTRN_CODE IS NULL --반송 상담등록이 아니고
			AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%') --미발송사유등록용 상담등록도 아님
		;
		

		/*===============================================================*/
		/* 수임후 추심활동내역 존재여부 확인 */
		/*===============================================================*/
		if (i_ck_cnt > 0) {

			/*===============================================================*/
			/* 3.추심활동내역-방법 	    				           			 */
			/*===============================================================*/
        	VCHINIT(hv_cnslt_gubn); /* 최초추심활동방법         */
        	VCHINIT(hv_recv_emid);  /* 담당자                 */
        	VCHINIT(hv_cnslt_cntnt);  /* 담당자                 */

			
			
			EXEC SQL OPEN cur_dyn_cnslt 
                USING :hv_trscp_dvscd, :hv_cstno, :hv_first_acadt, :hv_dbnno;

			EXEC SQL FETCH cur_dyn_cnslt 
                INTO :hv_cnslt_gubn, :hv_recv_emid, :hv_cnslt_cntnt;
			
			if (SQLCODE == 1403) {
                /* NO_DATA_FOUND: 조건에 맞는 내역이 필터링되어 없어진 경우 (공란 유지) */
            } else if (SQLCODE != 0) {
                printf("Dynamic Fetch Error = [%d][%s]\n", SQLCODE, SQLERRM);
            }

			/*
			EXEC SQL
				SELECT
					CASE
						WHEN AZTN_DVSCD IN ('B3','B4') THEN 'DM'
						WHEN AZTN_DVSCD IN ('B1','C1','C2','C3') THEN '전화'
						WHEN AZTN_DVSCD IN ('B5') THEN 'SMS'
						ELSE '기타'
					END CNSLT_GUBN,
					PRINC_EMINO,
					SUBSTR(CNSLT_CNTNT, 1, 400)
				INTO  
					:hv_cnslt_gubn,  :hv_recv_emid, :hv_cnslt_cntnt
				FROM
					(
					SELECT
						AZTN_DVSCD,
						PRINC_EMINO,
						CNSLT_CNTNT,
						ROW_NUMBER() OVER(ORDER BY FIRST_RGSDM) RN
					FROM    
						MSRCSPR01MT A
					WHERE    
						TRSCP_DVSCD = :hv_trscp_dvscd
					AND NVL(GRNTR_CSTNO, CSTNO) = :hv_cstno
					AND A.CNSLT_DATE >= :hv_first_acadt    		
					AND A.DBNNO = :hv_dbnno
					AND A.DATA_STTCD = '1'
					AND A.AZTN_DVSCD IN ('B3',   --B3	안내문(일괄)		                                                          
										'B4',   --B4	안내문(개별)		                                                          
										'B1',	--B1	전화송신		                                                          
										'C1',	--C1	자택전화송신
										'C2',	--C2	직장전화송신
										'C3',	--C3	휴대폰송신
										'B5')	--B5	SMS발송
					AND	NOT ( 
							A.AZTN_DVSCD IN ('B4', 'B3')
						AND ((A.TRSCP_DVSCD = '1501' AND (A.AZTN_DTLCD IN ('01','17'))) OR
							(A.TRSCP_DVSCD not in ('0901','0902','1701','1801','1803','1804','1901','1968') AND (A.AZTN_DTLCD IN ('07','47'))) OR
							(A.TRSCP_DVSCD in ('0901','0902','1701','1801','1803','1804','1901','1968') AND A.AZTN_DTLCD = '01'))
						AND A.PRMAM = 0)
					AND RTRN_CODE IS NULL --반송 상담등록이 아니고
					AND NOT (AZTN_DVSCD = 'B9' AND CNSLT_CNTNT LIKE '[%') --미발송사유등록용 상담등록도 아님
					) A
				WHERE
					RN = 1
			;
			*/
			
			/*===============================================================*/
			/* 4.최초추심활동시작 당시 추심담당자		           			 */
			/*===============================================================*/
        	VCHINIT(hv_recv_emid_name);/* 담당자명                 */
			EXEC SQL
			SELECT EMPLY_KRNNM 
			INTO   :hv_recv_emid_name
			FROM MHREMPL01MT
			WHERE EMINO = :hv_recv_emid;

			/*===============================================================*/
			/* 5.신용정보협회 등록번호            		           			 */
			/*===============================================================*/
        	VCHINIT(hv_rgytr_rgino); /* 담당 협회등록번호  */

			EXEC SQL
			SELECT TRIM(SUBSTR(RGYTR_RGINO,1,12))
			INTO  :hv_rgytr_rgino
			FROM MHREMPL09MT
			WHERE EMINO = :hv_recv_emid;
				
		}
		/*===============================================================*/
		/* 6.미발송사유													 */
		/*===============================================================*/
        VCHINIT(hv_ntytf_rsn_cntnt); /*미발송사유-참고항목               */     
		
		/*

		if (strcmp(hv_sndng_date.arr,"") == 0) {
			EXEC SQL			
			 SELECT	replace(replace(CNSLT_CNTNT,CHR(10),''),chr(13),'')
        	INTO	:hv_ntytf_rsn_cntnt
        	FROM
       	 	(
        		SELECT CNSLT_CNTNT
        		FROM MSRCSPR01MT
        		WHERE CSTNO = :hv_cstno
        		AND TRSCP_DVSCD = :hv_trscp_dvscd
        		AND CNSLT_DATE >= :hv_first_acadt
        		AND AZTN_DVSCD = 'B9'
        		AND DATA_STTCD = '1'
        		UNION ALL
        		SELECT CNSLT_CNTNT
        		FROM MSRCSPR01MT
        		WHERE GRNTR_CSTNO = :hv_cstno
        		AND TRSCP_DVSCD = :hv_trscp_dvscd
        		AND CNSLT_DATE >= :hv_first_acadt
        		AND AZTN_DVSCD = 'B9'
        		AND DATA_STTCD = '1')
        	WHERE	ROWNUM = 1;	
		}
		*/

		/*===============================================================*/
		/* 7.테이블에 작성												 */
		/*===============================================================*/
		memset(arr_rowid[arr_idx], 0x00, 51);
        strncpy(arr_rowid[arr_idx], (char *)hv_rowid.arr, hv_rowid.len);
        
        memset(arr_sndng_date[arr_idx], 0x00, 10);
        strncpy(arr_sndng_date[arr_idx], (char *)hv_sndng_date.arr, hv_sndng_date.len);
        
        memset(arr_cnslt_date[arr_idx], 0x00, 10);
        strncpy(arr_cnslt_date[arr_idx], (char *)hv_cnslt_date.arr, hv_cnslt_date.len);
        
		memset(arr_hv_stndy[arr_idx], 0x00, 10);
        strncpy(arr_hv_stndy[arr_idx], (char *)hv_stndy.arr, hv_stndy.len);

        memset(arr_cnslt_gubn[arr_idx], 0x00, 25);
        strncpy(arr_cnslt_gubn[arr_idx], (char *)hv_cnslt_gubn.arr, hv_cnslt_gubn.len);
        
        memset(arr_recv_emid_name[arr_idx], 0x00, 25);
        strncpy(arr_recv_emid_name[arr_idx], (char *)hv_recv_emid_name.arr, hv_recv_emid_name.len);
        
        memset(arr_rgytr_rgino[arr_idx], 0x00, 35);
        strncpy(arr_rgytr_rgino[arr_idx], (char *)hv_rgytr_rgino.arr, hv_rgytr_rgino.len);
        
        memset(arr_ntytf_rsn_cntnt[arr_idx], 0x00, 55);
        strncpy(arr_ntytf_rsn_cntnt[arr_idx], (char *)hv_ntytf_rsn_cntnt.arr, hv_ntytf_rsn_cntnt.len);

		memset(arr_sndng_dbnno[arr_idx], 0x00, 15);
        strncpy(arr_sndng_dbnno[arr_idx], (char *)hv_sndng_dbnno.arr, hv_sndng_dbnno.len);

		
		memset(arr_cnslt_cntnt[arr_idx], 0x00, 405);
        strncpy(arr_cnslt_cntnt[arr_idx], (char *)hv_cnslt_cntnt.arr, hv_cnslt_cntnt.len);

		


		arr_idx++;

		if (arr_idx == ARRAY_SIZE) {
            h_update_cnt = arr_idx;

            /* FOR 구문을 사용하여 5000건을 단 1번의 쿼리로 UPDATE */
            EXEC SQL FOR :h_update_cnt
                UPDATE MSRAUDT01MT
                   SET WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
				   	   --STNDY = :arr_hv_stndy,
                       --SNDNG_DATE = :arr_sndng_date,
                       CNSLT_DATE = :arr_cnslt_date,
                       CNSLT_GUBN = :arr_cnslt_gubn,
                       RECV_EMID_NAME = :arr_recv_emid_name,
                       RGYTR_RGINO = :arr_rgytr_rgino,
					   CNSLT_CNTNT = :arr_cnslt_cntnt
                       --NTYTF_RSN_CNTNT = :arr_ntytf_rsn_cntnt,
					   --SNDNG_DBNNO = :arr_sndng_dbnno
                 WHERE ROWID = :arr_rowid;

            if (SQLCODE != SQL_OK) {
				printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
				fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
				EXEC SQL CLOSE CURS1_5000;
        		return FAILURE;
			}

            /* 언두(Undo) 스페이스 확보를 위해 5000건마다 커밋 (선택) */
            /* EXEC SQL COMMIT; */

            arr_idx = 0; /* 업데이트 완료 후 인덱스 초기화 */
        }

		/*
		EXEC SQL
			UPDATE
				MSRAUDT01MT A
			SET
				WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
				SNDNG_DATE = :hv_sndng_date,
				CNSLT_DATE = :hv_cnslt_date,
				CNSLT_GUBN = :hv_cnslt_gubn,
				RECV_EMID_NAME = :hv_recv_emid_name,
				RGYTR_RGINO = :hv_rgytr_rgino,
				NTYTF_RSN_CNTNT = :hv_ntytf_rsn_cntnt
			WHERE
				ROWID = :hv_rowid
		;
		if (SQLCODE == SQL_NO_DATA) {
            printf("MSRAUDT01MT UPDATE NO DATA [%s][%s][%s]\n", hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
            fprintf(out,"MSRCRDT03MT UPDATE NO DATA = [%s][%s][%s]\n", hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);

            continue;
        }
        else
        if (SQLCODE != SQL_OK) {
            printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
            fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);

            continue;
        }
		*/

	} /* for end */

	/* 남은 자투리 데이터가 있다면 마지막 일괄 UPDATE 수행 */
    if (arr_idx > 0) {
        h_update_cnt = arr_idx;

        EXEC SQL FOR :h_update_cnt
            UPDATE MSRAUDT01MT
               SET WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
				   --STNDY = :arr_hv_stndy,
                   --SNDNG_DATE = :arr_sndng_date,
                   CNSLT_DATE = :arr_cnslt_date,
                   CNSLT_GUBN = :arr_cnslt_gubn,
                   RECV_EMID_NAME = :arr_recv_emid_name,
                   RGYTR_RGINO = :arr_rgytr_rgino,
				   CNSLT_CNTNT = :arr_cnslt_cntnt
                   --NTYTF_RSN_CNTNT = :arr_ntytf_rsn_cntnt,
				   --SNDNG_DBNNO = :arr_sndng_dbnno
             WHERE ROWID = :arr_rowid;

        if (SQLCODE != SQL_OK) {
			printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
			fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
			EXEC SQL CLOSE CURS1_5000;
			return FAILURE;
		}
        
        /*EXEC SQL COMMIT;*/
    }

    EXEC SQL CLOSE CURS1_5000;
   	return SUCCESS;
}



/*==========================================================================*/
/* 함 수 명 : int cmsraudt0001_list_SELECT()        					*/
/* 파라메터 : 없음                                                          */
/* 설    명 : Database 처리            	            			            */
/* 리 턴 값 : 성공시 SUCCESS(0), 실패시 FAILURE(-1)                         */
/*==========================================================================*/
int cmsraudt0001_list_SELECT ()
{
	/*---------------------------------------------------------------*/
	/* 추출대상 올리기 											 	 */
	/*---------------------------------------------------------------*/
    EXEC SQL DECLARE CURS1 CURSOR FOR
		SELECT
			/*+ FULL(A) */
			ROWID,
			
			CSTMR_DVSCD,
			DBNTR_CTGCD,
			CSTNO,
			TRSCP_DVSCD,
			DBNNO,
			CSTMR_NAME,
			DBTNM,
			FNSDT,
			FIRST_ACADT,
			DBTR_RLTCD,
			DEL_YN,
			TRSCP_DBNNO
		FROM    
			MSRAUDT01MT A
		WHERE   
			FIRST_RGSDM >= TO_DATE(:hv_rgsdt, 'YYYYMMDD')
		AND FIRST_RGSDM <  TO_DATE(:hv_rgsdt, 'YYYYMMDD') + 1
	;

	EXEC SQL OPEN CURS1;
	if (SQLCODE != SQL_OK) {
        printf("(CURS1 OPEN) SELECT ERROR = [%d][%s]\n", SQLCODE, SQLERRM);
        fprintf(o_fp,"(CURS1 OPEN) SELECT ERROR = [%d][%s]\n", SQLCODE, SQLERRM);
        EXEC SQL CLOSE CURS1;
        return FAILURE;
    }

    for (jj=0;;jj++) {
		VCHINIT(hv_rowid ); 	  /* ROWID		            */        
		VCHINIT(hv_cstmr_dvscd ); /* 개인/법인구분            */        
		VCHINIT(hv_dbntr_ctgcd ); /* 채권종류                 */
        VCHINIT(hv_dbnno  );      /* 채권번호                 */
        VCHINIT(hv_cstmr_name);   /* 채무자성명               */
		VCHINIT(hv_mbdb_name);    /* 주채무자성명               */		
		VCHINIT(hv_first_acadt);  /* 수임일자                 */
		VCHINIT(hv_dbtr_rltname);  /* 관계구분                 */
        VCHINIT(hv_cstno);        /* 고객번호-참고항목        */
		VCHINIT(hv_trscp_dvscd);  /*위임사-참고항목           */ 
        VCHINIT(hv_fnsdt);        /* 완결일자-참고항목        */
		VCHINIT(hv_del_yn);       /* 보증인삭제여부-참고항목        */
		
        VCHINIT(hv_sndng_date);  /* 채권수임안내문발송일자   */
        VCHINIT(hv_cnslt_date);  /* 최초추심활동일자         */
        VCHINIT(hv_cnslt_gubn); /* 최초추심활동방법         */        
        VCHINIT(hv_recv_emid_name);/* 담당자명                 */
        VCHINIT(hv_rgytr_rgino); /* 담당 협회등록번호  */
        VCHINIT(hv_ntytf_rsn_cntnt); /*미발송사유-참고항목               */
		VCHINIT(hv_trscp_dbnno); /* 위임사채권번호               */

		EXEC SQL FETCH CURS1 INTO
			:hv_rowid,
			:hv_cstmr_dvscd,	:hv_dbntr_ctgcd,	:hv_cstno,  	:hv_trscp_dvscd,
			:hv_dbnno, 			:hv_cstmr_name,		:hv_mbdb_name,	:hv_fnsdt,
			:hv_first_acadt,	:hv_dbtr_rltname,	:hv_del_yn,		:hv_trscp_dbnno;

		if (SQLCODE == SQL_NO_DATA)
			break;
        else if (SQLCODE != SQL_OK) {
			printf ("cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			fprintf(out,"cmsraudt0001_list_SELECT_5000_SQL_ERR(MSRAUDT01MT_fetch) : [%d][%s][%s][%s]\n"
								, SQLCODE, SQLERRM, hv_dbnno.arr, hv_cstno.arr);
			EXEC SQL CLOSE CURS1;
			return FAILURE;
        }

		l_tot_cnt++;

		if (l_tot_cnt % 100 == 0) {
			CHRINIT(buf); common_gettime(buf,":");
			printf ("cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
			fprintf (out,"cmsraudt0001_list_SELECT_5000=========>%6d건 진행..[%s]\n",l_tot_cnt,buf);
		}


		/*===============================================================*/
		/* 1.수임안내문 발송일    					           			 */
		/*===============================================================*/
        VCHINIT(hv_sndng_date);  /* 채권수임안내문발송일자   */
		EXEC SQL
		SELECT MIN(STNDY)
		INTO   :hv_sndng_date
        FROM MSRURSN01MT
        WHERE TRSCP_DVSCD = :hv_trscp_dvscd
        AND CSTNO = :hv_cstno        
        AND STNDY >= :hv_first_acadt
        AND DATA_STTCD = '1'
        --and INSTR_STGCD IN ('01','32');
		and INSTR_STGCD IN ('01');


		/*===============================================================*/
		/* 최초활동시작일자,방법             					         */
		/* 채무자/채권번호 조건 										 */
		/*===============================================================*/
		i_ck_cnt = 0;
		EXEC SQL			
		SELECT   COUNT(*), MIN(CNSLT_DATE)
		INTO     :i_ck_cnt, :hv_cnslt_date
		FROM     MSRCSPR01MT
		WHERE    TRSCP_DVSCD = :hv_trscp_dvscd
		AND		 NVL(GRNTR_CSTNO,CSTNO) = :hv_cstno
		AND      CNSLT_DATE >= :hv_first_acadt    		
		AND      DBNNO = :hv_dbnno 
		/*AND      DBNNO IN (SELECT X.DBNNO
                           FROM   MSRCRDT03MT X, MSRFNGR01MT Y
                           WHERE  X.DBNNO = Y.DBNNO
                           AND    X.TRSCP_DVSCD = :hv_trscp_dvscd
                           AND    X.FIRST_ACADT = :hv_first_acadt
                           AND    Y.CSTNO = :hv_cstno
                           AND    X.DATA_STTCD = '1')*/
		/* CSACT_DVSCD - 상담활동구분코드 */
		AND	     INSTR(CNSLT_CNTNT,'수임사실') = 0		
		AND      AZTN_DVSCD IN ('B3',   --B3	안내문(일괄)		                                                          
								'B4',   --B4	안내문(개별)		                                                          
								'B1',	--B1	전화송신		                                                          
								'C1',	--C1	자택전화송신
								'C2',	--C2	직장전화송신
								'C3',	--C3	휴대폰송신
								'B5')	--B5	SMS발송
		AND      DATA_STTCD = '1';		
		

		/*===============================================================*/
		/* 수임후 추심활동내역 존재여부 확인 */
		/*===============================================================*/
		if (i_ck_cnt > 0) {

			/*===============================================================*/
			/* 3.추심활동내역-방법 	    				           			 */
			/*===============================================================*/
        	VCHINIT(hv_cnslt_gubn); /* 최초추심활동방법         */
        	VCHINIT(hv_recv_emid);  /* 담당자                 */
			EXEC SQL
			SELECT   CASE
					 WHEN AZTN_DVSCD IN ('B3','B4') THEN 'DM'
					 WHEN AZTN_DVSCD IN ('B1','C1','C2','C3') THEN '전화'
					 WHEN AZTN_DVSCD IN ('B5') THEN 'SMS'
					 ELSE '기타'
					 END,
					 PRINC_EMINO
			INTO  :hv_cnslt_gubn,  :hv_recv_emid
			FROM     MSRCSPR01MT
			WHERE    NVL(GRNTR_CSTNO,CSTNO) = :hv_cstno	  		
			AND      CNSLT_DATE = :hv_cnslt_date
			AND      TRSCP_DVSCD = :hv_trscp_dvscd
			AND      DBNNO = :hv_dbnno         
        	/*AND      DBNNO IN (SELECT X.DBNNO
                           FROM   MSRCRDT03MT X, MSRFNGR01MT Y
                           WHERE  X.DBNNO = Y.DBNNO
                           AND    X.TRSCP_DVSCD = :hv_trscp_dvscd
                           AND    X.FIRST_ACADT = :hv_first_acadt
                           AND    Y.CSTNO = :hv_cstno
                           AND    X.DATA_STTCD = '1')*/
			AND	     INSTR(CNSLT_CNTNT,'수임사실') = 0		
			AND      AZTN_DVSCD IN ('B3',   --B3	안내문(일괄)		                                                          
									'B4',   --B4	안내문(개별)		                                                          
									'B1',	--B1	전화송신		                                                          
									'C1',	--C1	자택전화송신
									'C2',	--C2	직장전화송신
									'C3',	--C3	휴대폰송신
									'B5')	--B5	SMS발송
			AND      DATA_STTCD = '1'
			AND      ROWNUM = 1;
			
			/*===============================================================*/
			/* 4.최초추심활동시작 당시 추심담당자		           			 */
			/*===============================================================*/
        	VCHINIT(hv_recv_emid_name);/* 담당자명                 */
			EXEC SQL
			SELECT EMPLY_KRNNM 
			INTO   :hv_recv_emid_name
			FROM MHREMPL01MT
			WHERE EMINO = :hv_recv_emid;

			/*===============================================================*/
			/* 5.신용정보협회 등록번호            		           			 */
			/*===============================================================*/
        	VCHINIT(hv_rgytr_rgino); /* 담당 협회등록번호  */

			EXEC SQL
			SELECT TRIM(SUBSTR(RGYTR_RGINO,1,12))
			INTO  :hv_rgytr_rgino
			FROM MHREMPL09MT
			WHERE EMINO = :hv_recv_emid;
				
		}
		/*===============================================================*/
		/* 6.미발송사유													 */
		/*===============================================================*/
        VCHINIT(hv_ntytf_rsn_cntnt); /*미발송사유-참고항목               */          

		if (strcmp(hv_sndng_date.arr,"") == 0) {
			EXEC SQL			
			 SELECT	replace(replace(CNSLT_CNTNT,CHR(10),''),chr(13),'')
        	INTO	:hv_ntytf_rsn_cntnt
        	FROM
       	 	(
        		SELECT CNSLT_CNTNT
        		FROM MSRCSPR01MT
        		WHERE CSTNO = :hv_cstno
        		AND TRSCP_DVSCD = :hv_trscp_dvscd
        		AND CNSLT_DATE >= :hv_first_acadt
        		AND AZTN_DVSCD = 'B9'
        		AND DATA_STTCD = '1'
        		UNION ALL
        		SELECT CNSLT_CNTNT
        		FROM MSRCSPR01MT
        		WHERE GRNTR_CSTNO = :hv_cstno
        		AND TRSCP_DVSCD = :hv_trscp_dvscd
        		AND CNSLT_DATE >= :hv_first_acadt
        		AND AZTN_DVSCD = 'B9'
        		AND DATA_STTCD = '1')
        	WHERE	ROWNUM = 1;	
		}

		/*===============================================================*/
		/* 7.테이블에 작성												 */
		/*===============================================================*/
		EXEC SQL
			UPDATE
				MSRAUDT01MT A
			SET
				WORKDT = TO_CHAR(SYSDATE, 'YYYYMMDD'),
				SNDNG_DATE = :hv_sndng_date,
				CNSLT_DATE = :hv_cnslt_date,
				CNSLT_GUBN = :hv_cnslt_gubn,
				RECV_EMID_NAME = :hv_recv_emid_name,
				RGYTR_RGINO = :hv_rgytr_rgino,
				NTYTF_RSN_CNTNT = :hv_ntytf_rsn_cntnt
			WHERE
				ROWID = :hv_rowid
		;
		if (SQLCODE == SQL_NO_DATA) {
            printf("MSRAUDT01MT UPDATE NO DATA [%s][%s][%s]\n", hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
            fprintf(out,"MSRCRDT03MT UPDATE NO DATA = [%s][%s][%s]\n", hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);

            continue;
        }
        else
        if (SQLCODE != SQL_OK) {
            printf("MSRAUDT01MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);
            fprintf(out,"MSRCRDT03MT UPDATE ERROR = [%d][%s], [%s][%s][%s]\n", SQLCODE, SQLERRM, hv_rowid.arr, hv_dbnno.arr, hv_trscp_dbnno.arr);

            continue;
        }

	} /* for end */

    EXEC SQL CLOSE CURS1;
   	return SUCCESS;
}


